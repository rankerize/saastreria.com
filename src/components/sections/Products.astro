---
import { products } from '../../data/services';
---
<section id="productos" class="py-24 px-6" style="background:#FFFFFF;border-top:1px solid rgba(0,0,0,0.06);">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-16">
      <span class="inline-block px-3 py-1 rounded-full border border-[#F59E0B]/25 bg-[#F59E0B]/08 text-[#D97706] text-xs font-medium mb-4" style="background:rgba(245,158,11,0.07);">
        Productos propios
      </span>
      <h2 class="text-3xl sm:text-4xl font-bold mb-4 text-[#0F0F1A]" style="font-family: 'Plus Jakarta Sans', sans-serif;">
        Software listo para usar hoy
      </h2>
      <p class="text-[#374151] max-w-xl mx-auto">
        Además de desarrollar soluciones a medida, diseñamos productos configurables para necesidades recurrentes.
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-8">
      {products.map((p, i) => (
        <div class="commercial-card rounded-2xl overflow-hidden hover:border-[#F59E0B]/25 transition-all hover:shadow-[0_8px_32px_rgba(245,158,11,0.07)]">
          <!-- Product header -->
          <div class="p-8 pb-6">
            <div class="flex items-start justify-between mb-4">
              <span class="inline-block px-2 py-0.5 rounded-full bg-green-50 border border-green-200 text-green-700 text-xs font-medium">
                {p.badge}
              </span>
            </div>
            <h3 class="text-xl font-bold text-[#0F0F1A] mb-1" style="font-family: 'Plus Jakarta Sans', sans-serif;">{p.name}</h3>
            <p class="text-[#D97706] text-sm font-medium mb-4">{p.tagline}</p>
            <p class="text-[#374151] text-sm leading-relaxed">{p.description}</p>
          </div>

          <!-- Features -->
          <div class="px-8 pb-6">
            <ul class="space-y-2">
              {p.features.map(f => (
                <li class="flex items-start gap-2.5 text-sm text-[#374151]">
                  <svg class="w-4 h-4 text-[#1B3461] flex-shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M20 6L9 17l-5-5"/>
                  </svg>
                  {f}
                </li>
              ))}
            </ul>
          </div>

          <!-- CTA -->
          <div class="px-8 pb-8">
            <a
              href={p.href}
              class="inline-flex items-center gap-2 w-full justify-center px-5 py-3 rounded-xl border border-[#F59E0B]/25 text-[#D97706] hover:bg-[#F59E0B]/06 font-medium text-sm transition-all"
              style="background:rgba(245,158,11,0.04);"
            >
              Conocer producto
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
