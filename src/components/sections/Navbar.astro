---
const path = Astro.url.pathname;
const links = [
  { href: '/soluciones/', label: 'Soluciones' },
  { href: '/industrias/', label: 'Industrias' },
  { href: '/productos/', label: 'Productos' },
  { href: '/como-trabajamos/', label: 'Cómo trabajamos' },
  { href: '/blog/', label: 'Blog' },
];
---

<header class="fixed top-0 left-0 right-0 z-50 border-b bg-white/90 backdrop-blur-xl" style="border-color: rgba(0,0,0,0.07);">
  <nav class="max-w-7xl mx-auto px-5 sm:px-6 h-16 flex items-center justify-between" aria-label="Navegación principal">
    <a href="/" class="flex items-center min-h-11 select-none gap-1" aria-label="Saastreria, inicio">
      <!-- Monograma S con aguja + código -->
      <span style="
        font-family:'Cormorant Garamond',Georgia,serif;
        font-weight:700;font-size:1.45rem;color:#1B3461;
        line-height:1;display:inline-flex;align-items:center;gap:0;
        letter-spacing:-0.01em;
      ">
        Saastreri
        <svg width="8" height="18" viewBox="0 0 8 18" fill="none" style="margin:0 1px;flex-shrink:0;display:inline-block;vertical-align:middle;" aria-hidden="true">
          <ellipse cx="4" cy="3.5" rx="3" ry="2.5" stroke="#BFA255" stroke-width="1.3" fill="none"/>
          <line x1="4" y1="6" x2="4" y2="15.5" stroke="#BFA255" stroke-width="1.3" stroke-linecap="round"/>
          <path d="M3 14.5 L4 17.5 L5 14.5" fill="#BFA255"/>
        </svg>
        a
      </span>
      <span aria-hidden="true" style="
        font-family:'JetBrains Mono',monospace;
        font-size:0.6rem;font-weight:500;
        color:#BFA255;opacity:0.75;
        margin-left:4px;letter-spacing:-0.03em;
        line-height:1;
      ">&lt;/&gt;</span>
    </a>

    <div class="hidden lg:flex items-center gap-7 text-sm text-[#64748B]">
      {links.map((link) => (
        <a href={link.href} aria-current={path.startsWith(link.href) ? 'page' : undefined} class:list={['nav-link text-[#64748B] hover:text-[#0F0F1A]', path.startsWith(link.href) && '!text-[#0F0F1A] font-medium']}>{link.label}</a>
      ))}
    </div>

    <a href="/diagnostico/" class="hidden lg:inline-flex btn-primary text-sm px-4 py-2.5">Solicitar diagnóstico</a>

    <button id="menu-toggle" class="lg:hidden inline-flex items-center justify-center w-11 h-11 rounded-lg text-[#64748B] hover:text-[#0F0F1A] hover:bg-black/5" aria-expanded="false" aria-controls="mobile-menu" aria-label="Abrir menú">
      <svg class="menu-open" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      <svg class="menu-close hidden" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 6 12 12M18 6 6 18"/></svg>
    </button>
  </nav>

  <div id="mobile-menu" class="lg:hidden hidden border-t bg-white px-5 py-5" style="border-color: rgba(0,0,0,0.06);">
    <div class="flex flex-col gap-1">
      {links.map((link) => <a href={link.href} class="min-h-12 flex items-center rounded-lg px-3 text-[#64748B] hover:bg-black/[0.03] hover:text-[#0F0F1A]">{link.label}</a>)}
      <a href="/nosotros/" class="min-h-12 flex items-center rounded-lg px-3 text-[#64748B] hover:bg-black/[0.03] hover:text-[#0F0F1A]">Nosotros</a>
      <a href="/diagnostico/" class="btn-primary mt-3 w-full">Solicitar diagnóstico</a>
    </div>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('#menu-toggle');
  const menu = document.querySelector<HTMLElement>('#mobile-menu');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    toggle.setAttribute('aria-label', open ? 'Abrir menú' : 'Cerrar menú');
    menu?.classList.toggle('hidden');
    toggle.querySelector('.menu-open')?.classList.toggle('hidden');
    toggle.querySelector('.menu-close')?.classList.toggle('hidden');
  });
</script>
