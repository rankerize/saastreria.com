---
---
<section class="relative min-h-screen flex items-center justify-center overflow-hidden pt-16" style="background: #07071a;">

  <!-- ── Noise texture Mac-style ── -->
  <div class="absolute inset-0 pointer-events-none opacity-[0.025]" aria-hidden="true"
       style="background-image: url('data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%22200%22 height=%22200%22><filter id=%22n%22><feTurbulence type=%22fractalNoise%22 baseFrequency=%220.9%22 numOctaves=%224%22 stitchTiles=%22stitch%22/></filter><rect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23n)%22 opacity=%221%22/></svg>');"></div>

  <!-- ── Color blobs ── -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
    <div class="absolute" style="top:-10%;right:-5%;width:700px;height:700px;border-radius:50%;background:radial-gradient(circle,rgba(124,58,237,0.22) 0%,rgba(99,102,241,0.1) 45%,transparent 70%);animation:blobFloat 10s ease-in-out infinite;"></div>
    <div class="absolute" style="bottom:-20%;left:-10%;width:600px;height:600px;border-radius:50%;background:radial-gradient(circle,rgba(6,182,212,0.18) 0%,rgba(59,130,246,0.08) 45%,transparent 70%);animation:blobFloat 13s ease-in-out infinite reverse;"></div>
    <div class="absolute" style="top:40%;right:18%;width:350px;height:350px;border-radius:50%;background:radial-gradient(circle,rgba(245,158,11,0.1) 0%,transparent 65%);animation:blobFloat 16s ease-in-out infinite;animation-delay:-6s;"></div>
    <!-- Grid tenue -->
    <div class="absolute inset-0 bg-grid" style="opacity:0.35;"></div>
    <!-- Vignette bottom -->
    <div class="absolute bottom-0 left-0 right-0 h-40 pointer-events-none" style="background:linear-gradient(to bottom,transparent,#07071a);"></div>
  </div>

  <!-- ── Partículas ── -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
    {[
      {x:7, y:18,s:3,c:'#818CF8',d:7, dl:0  },
      {x:22,y:72,s:2,c:'#06B6D4',d:9, dl:1.5},
      {x:36,y:28,s:4,c:'#8B5CF6',d:7, dl:3  },
      {x:52,y:83,s:2,c:'#F59E0B',d:10,dl:0.5},
      {x:67,y:15,s:3,c:'#818CF8',d:6, dl:2  },
      {x:80,y:55,s:2,c:'#10B981',d:8, dl:4  },
      {x:91,y:10,s:3,c:'#06B6D4',d:7, dl:1  },
      {x:13,y:50,s:2,c:'#EC4899',d:9, dl:2.5},
      {x:46,y:62,s:3,c:'#8B5CF6',d:6, dl:3.5},
      {x:83,y:78,s:4,c:'#F59E0B',d:8, dl:0.8},
      {x:28,y:90,s:2,c:'#818CF8',d:7, dl:1.2},
      {x:71,y:42,s:2,c:'#06B6D4',d:9, dl:4.5},
      {x:57,y:8, s:3,c:'#EC4899',d:6, dl:2.2},
    ].map(p=>(
      <div class="absolute rounded-full particle-float"
           style={`left:${p.x}%;top:${p.y}%;width:${p.s}px;height:${p.s}px;background:${p.c};opacity:0.5;animation-duration:${p.d}s;animation-delay:${p.dl}s;box-shadow:0 0 ${p.s*3}px ${p.c};`}></div>
    ))}
  </div>

  <!-- ── Contenido ── -->
  <div class="relative z-10 w-full max-w-7xl mx-auto px-6 py-20 grid lg:grid-cols-[1fr_1.05fr] gap-14 xl:gap-20 items-center">

    <!-- Columna izquierda -->
    <div class="min-w-0">

      <!-- Badge estilo Mac pill -->
      <div class="animate-fade-up delay-1 inline-flex items-center gap-2 px-4 py-2 rounded-full mb-8"
           style="background:rgba(124,58,237,0.12);border:1px solid rgba(139,92,246,0.3);backdrop-filter:blur(12px);">
        <span class="w-2 h-2 rounded-full bg-violet-400 animate-pulse" style="box-shadow:0 0 8px rgba(139,92,246,0.9);"></span>
        <span class="text-violet-300 text-xs font-semibold tracking-wide">Colombia ✦ LATAM — Software y productos digitales</span>
      </div>

      <!-- H1 -->
      <h1 class="animate-fade-up delay-2 font-extrabold leading-[1.07] tracking-tight mb-7"
          style="font-family:'Plus Jakarta Sans',sans-serif;font-size:clamp(2.6rem,5vw,4.1rem);">
        <span class="text-white">Construimos software</span><br/>
        <span class="text-white">que transforma</span><br/>
        <span style="background:linear-gradient(135deg,#818CF8 0%,#C084FC 35%,#F472B6 65%,#FB923C 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;">operaciones reales.</span>
      </h1>

      <p class="animate-fade-up delay-3 text-lg leading-relaxed mb-10 max-w-lg" style="color:#94A3B8;">
        Diseñamos y construimos productos digitales — software a la medida, automatizaciones e inteligencia de datos para empresas en Colombia y LATAM.
      </p>

      <!-- CTAs -->
      <div class="animate-fade-up delay-4 flex flex-col sm:flex-row gap-3 mb-12">
        <a href="/diagnostico/"
           class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-2xl text-white font-bold text-sm transition-all duration-300 hover:-translate-y-0.5"
           style="background:linear-gradient(135deg,#7C3AED,#6366F1);box-shadow:0 0 28px rgba(124,58,237,0.35),0 1px 0 rgba(255,255,255,0.15) inset;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          Solicitar diagnóstico
        </a>
        <a href="/soluciones/"
           class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-2xl font-semibold text-sm transition-all duration-300 hover:-translate-y-0.5 hover:bg-white/[0.07]"
           style="border:1px solid rgba(255,255,255,0.11);color:#CBD5E1;background:rgba(255,255,255,0.03);backdrop-filter:blur(8px);">
          Ver productos
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>

      <!-- Chips -->
      <div class="animate-fade-up delay-4 flex flex-wrap gap-2">
        {[
          {label:'Software a medida',    c:'#818CF8'},
          {label:'IA Empresarial',       c:'#C084FC'},
          {label:'Automatización',       c:'#F472B6'},
          {label:'Datos e inteligencia', c:'#06B6D4'},
          {label:'Colombia · LATAM',     c:'#10B981'},
        ].map(ch=>(
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-medium cursor-default"
                style={`background:${ch.c}18;border:1px solid ${ch.c}30;color:${ch.c};`}>
            <span class="w-1.5 h-1.5 rounded-full" style={`background:${ch.c};`}></span>
            {ch.label}
          </span>
        ))}
      </div>
    </div>

    <!-- ── Columna derecha: ventana Mac ── -->
    <div class="hidden lg:flex items-center justify-center animate-fade-up delay-3 relative select-none">

      <!-- Glow ambiente -->
      <div class="absolute w-[480px] h-[480px] rounded-full pointer-events-none" style="background:radial-gradient(circle,rgba(99,102,241,0.2) 0%,transparent 70%);filter:blur(50px);"></div>

      <!-- Badge flotante arriba-derecha -->
      <div class="absolute -top-6 -right-2 z-20" style="animation:floatBadge 4s ease-in-out infinite;">
        <div class="flex items-center gap-2 px-3.5 py-2 rounded-xl"
             style="background:rgba(16,185,129,0.12);border:1px solid rgba(16,185,129,0.28);backdrop-filter:blur(16px);">
          <span class="w-1.5 h-1.5 rounded-full bg-green-400 live-dot"></span>
          <span class="text-xs font-semibold text-green-300">94% eficiencia operativa</span>
        </div>
      </div>

      <!-- Badge flotante abajo-izquierda -->
      <div class="absolute -bottom-6 -left-2 z-20" style="animation:floatBadge 5s ease-in-out infinite;animation-delay:-2.5s;">
        <div class="flex items-center gap-2.5 px-3.5 py-2 rounded-xl"
             style="background:rgba(139,92,246,0.12);border:1px solid rgba(139,92,246,0.28);backdrop-filter:blur(16px);">
          <div class="flex -space-x-1.5">
            {['#6366F1','#8B5CF6','#EC4899'].map(c=>(
              <div class="w-5 h-5 rounded-full border-2 border-[#07071a] flex items-center justify-center text-white" style={`background:${c};font-size:8px;`}>
                <svg width="8" height="8" viewBox="0 0 24 24" fill="white"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              </div>
            ))}
          </div>
          <span class="text-xs font-semibold text-violet-300">+248 usuarios activos</span>
        </div>
      </div>

      <!-- Ventana macOS -->
      <div class="relative w-full max-w-[540px] rounded-[18px] overflow-hidden hero-mac-window"
           style="
             transform: perspective(1100px) rotateY(-9deg) rotateX(4deg);
             box-shadow:
               0 2px 0 rgba(255,255,255,0.08) inset,
               0 -1px 0 rgba(0,0,0,0.4) inset,
               0 35px 90px rgba(99,102,241,0.3),
               0 8px 30px rgba(0,0,0,0.6),
               0 0 0 1px rgba(255,255,255,0.07);
           ">

        <!-- Traffic lights Mac ── -->
        <div class="flex items-center gap-0 px-4 py-3"
             style="background:linear-gradient(180deg,rgba(40,40,60,0.98) 0%,rgba(20,20,38,0.98) 100%);border-bottom:1px solid rgba(255,255,255,0.06);">
          <!-- Dots grupo -->
          <div class="flex items-center gap-2 mr-4">
            <div class="w-3.5 h-3.5 rounded-full flex items-center justify-center group/dot" style="background:#FF5F57;box-shadow:0 0 0 0.5px rgba(0,0,0,0.3);">
              <span class="opacity-0 group-hover/dot:opacity-100 text-[7px] font-black text-red-900">✕</span>
            </div>
            <div class="w-3.5 h-3.5 rounded-full" style="background:#FFBD2E;box-shadow:0 0 0 0.5px rgba(0,0,0,0.3);"></div>
            <div class="w-3.5 h-3.5 rounded-full" style="background:#28C840;box-shadow:0 0 0 0.5px rgba(0,0,0,0.3);"></div>
          </div>
          <!-- Tab bar estilo Safari -->
          <div class="flex-1 flex items-center justify-center">
            <div class="flex items-center gap-1.5 px-3 py-1 rounded-md text-xs font-mono" style="background:rgba(255,255,255,0.06);color:#94A3B8;max-width:240px;">
              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#6366F1" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
              <span class="truncate">coordrutas.saastreria.cloud</span>
            </div>
          </div>
          <!-- Status -->
          <div class="flex items-center gap-1.5 text-xs font-mono text-green-400">
            <span class="w-1.5 h-1.5 rounded-full bg-green-400 live-dot"></span>
            LIVE
          </div>
        </div>

        <!-- Imagen -->
        <div class="relative overflow-hidden">
          <img src="/mockup-rutas.jpg"
               alt="CoordRutas — dashboard logístico en tiempo real"
               class="w-full block object-cover"
               style="aspect-ratio:16/9;"
               loading="eager" decoding="async"/>
          <!-- Overlay gradiente bottom -->
          <div class="absolute inset-0 pointer-events-none" style="background:linear-gradient(180deg,transparent 55%,rgba(7,7,26,0.65) 100%);"></div>
        </div>

        <!-- Status bar abajo estilo Mac ── -->
        <div class="flex items-center gap-3 px-4 py-2" style="background:rgba(12,12,28,0.96);border-top:1px solid rgba(255,255,255,0.05);">
          <span class="text-xs font-mono flex-1" style="color:#6366F1;" id="hero-typing-mac"></span>
          <span class="typing-cursor text-xs font-mono" style="color:#8B5CF6;">|</span>
          <span class="ml-auto text-xs font-mono" style="color:#334155;">Python 3.12 · Prod</span>
        </div>
      </div>
    </div>

  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10 flex flex-col items-center gap-1.5 opacity-30">
    <span class="text-[10px] font-mono tracking-widest uppercase" style="color:#475569;">scroll</span>
    <div class="animate-bounce">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
    </div>
  </div>
</section>

<style>
  @keyframes blobFloat {
    0%,100% { transform:translate(0,0) scale(1); }
    33%      { transform:translate(18px,-22px) scale(1.03); }
    66%      { transform:translate(-12px,14px) scale(0.97); }
  }
  @keyframes floatBadge {
    0%,100% { transform:translateY(0px); }
    50%      { transform:translateY(-8px); }
  }
  .hero-mac-window { transition: transform 0.6s cubic-bezier(0.23,1,0.32,1), box-shadow 0.6s ease; }
  .hero-mac-window:hover {
    transform: perspective(1100px) rotateY(-3deg) rotateX(1.5deg) !important;
    box-shadow:
      0 2px 0 rgba(255,255,255,0.1) inset,
      0 -1px 0 rgba(0,0,0,0.4) inset,
      0 50px 120px rgba(99,102,241,0.45),
      0 10px 40px rgba(0,0,0,0.7),
      0 0 0 1px rgba(255,255,255,0.1) !important;
  }
</style>

<script>
  const lines = [
    '> Construyendo CoordRutas v2.4...',
    '> Optimización de rutas IA activa ✓',
    '> 12 vehículos en tiempo real',
    '> ETA calculado con precisión 98%',
  ];
  const el = document.getElementById('hero-typing-mac');
  if (el) {
    let li=0,ci=0,deleting=false;
    function tick() {
      const line = lines[li % lines.length];
      if (!deleting) {
        el.textContent = line.slice(0,++ci);
        if (ci>=line.length){ deleting=true; setTimeout(tick,2200); return; }
      } else {
        el.textContent = line.slice(0,--ci);
        if (ci===0){ deleting=false; li++; setTimeout(tick,500); return; }
      }
      setTimeout(tick, deleting?28:48);
    }
    setTimeout(tick, 1200);
  }
</script>
