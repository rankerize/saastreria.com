---
---
<section class="relative min-h-screen flex flex-col items-center justify-center overflow-hidden pt-16" style="background: #FFFFFF;">

  <!-- Subtle grid -->
  <div class="absolute inset-0 bg-grid pointer-events-none" aria-hidden="true" style="opacity:0.5;"></div>

  <!-- Very subtle violet glow top-center -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[900px] h-[500px] pointer-events-none" aria-hidden="true"
       style="background:radial-gradient(ellipse at 50% 0%,rgba(99,102,241,0.07) 0%,transparent 65%);"></div>

  <!-- ── Contenido centrado ── -->
  <div class="relative z-10 w-full max-w-4xl mx-auto px-6 pt-20 pb-12 flex flex-col items-center text-center">

    <!-- Badge eyebrow -->
    <div class="animate-fade-up delay-1 inline-flex items-center gap-2 px-4 py-2 rounded-full mb-8"
         style="background:rgba(99,102,241,0.07);border:1px solid rgba(99,102,241,0.2);">
      <span class="w-2 h-2 rounded-full bg-[#6366F1] live-dot"></span>
      <span class="text-[#6366F1] text-xs font-semibold tracking-wide">Colombia ✦ LATAM — Software y productos digitales</span>
    </div>

    <!-- H1 -->
    <h1 class="animate-fade-up delay-2 font-extrabold leading-[1.06] tracking-tight mb-6"
        style="font-family:'Plus Jakarta Sans',sans-serif;font-size:clamp(2.8rem,6vw,4.8rem);">
      <span style="color:#0F0F1A;">Construimos software</span><br/>
      <span style="color:#0F0F1A;">que transforma</span><br/>
      <span class="gradient-text">operaciones reales.</span>
    </h1>

    <p class="animate-fade-up delay-3 text-lg leading-relaxed mb-10 max-w-xl" style="color:#64748B;">
      Diseñamos y construimos productos digitales — software a la medida, automatizaciones e inteligencia de datos para empresas en Colombia y LATAM.
    </p>

    <!-- CTAs -->
    <div class="animate-fade-up delay-4 flex flex-col sm:flex-row gap-3 mb-12">
      <a href="/diagnostico/"
         class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-2xl text-white font-bold text-sm transition-all duration-300 hover:-translate-y-0.5"
         style="background:linear-gradient(135deg,#6366F1,#8B5CF6);box-shadow:0 8px 28px rgba(99,102,241,0.3);">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        Solicitar diagnóstico
      </a>
      <a href="/soluciones/"
         class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-2xl font-semibold text-sm transition-all duration-300 hover:-translate-y-0.5 btn-secondary">
        Ver productos
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>

    <!-- Chips -->
    <div class="animate-fade-up delay-4 flex flex-wrap justify-center gap-2">
      {[
        {label:'Software a medida',    c:'#6366F1'},
        {label:'IA Empresarial',       c:'#8B5CF6'},
        {label:'Automatización',       c:'#EC4899'},
        {label:'Datos e inteligencia', c:'#06B6D4'},
        {label:'Colombia · LATAM',     c:'#10B981'},
      ].map(ch=>(
        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-medium cursor-default"
              style={`background:${ch.c}10;border:1px solid ${ch.c}28;color:${ch.c};`}>
          <span class="w-1.5 h-1.5 rounded-full" style={`background:${ch.c};`}></span>
          {ch.label}
        </span>
      ))}
    </div>
  </div>

  <!-- ── Mockup Mac grande ── -->
  <div class="relative z-10 w-full max-w-[860px] mx-auto px-6 pb-20 animate-fade-up delay-4 select-none">

    <!-- Badge flotante arriba-derecha -->
    <div class="absolute -top-5 right-6 z-20 hidden sm:block" style="animation:floatBadge 4s ease-in-out infinite;">
      <div class="flex items-center gap-2 px-3.5 py-2 rounded-xl bg-white border shadow-md" style="border-color:rgba(16,185,129,0.25);box-shadow:0 4px 16px rgba(16,185,129,0.12);">
        <span class="w-1.5 h-1.5 rounded-full bg-green-500 live-dot"></span>
        <span class="text-xs font-semibold text-green-700">94% eficiencia operativa</span>
      </div>
    </div>

    <!-- Badge flotante abajo-izquierda -->
    <div class="absolute -bottom-5 left-6 z-20 hidden sm:block" style="animation:floatBadge 5s ease-in-out infinite;animation-delay:-2.5s;">
      <div class="flex items-center gap-2.5 px-3.5 py-2 rounded-xl bg-white border shadow-md" style="border-color:rgba(99,102,241,0.2);box-shadow:0 4px 16px rgba(99,102,241,0.1);">
        <div class="flex -space-x-1.5">
          {['#6366F1','#8B5CF6','#EC4899'].map(c=>(
            <div class="w-5 h-5 rounded-full border-2 border-white flex items-center justify-center" style={`background:${c};font-size:8px;`}>
              <svg width="8" height="8" viewBox="0 0 24 24" fill="white"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            </div>
          ))}
        </div>
        <span class="text-xs font-semibold text-[#6366F1]">+248 usuarios activos</span>
      </div>
    </div>

    <!-- Ventana macOS -->
    <div class="relative w-full rounded-2xl overflow-hidden hero-mac-window"
         style="
           transform: perspective(1200px) rotateX(3deg) rotateY(-1deg);
           box-shadow:
             0 2px 0 rgba(255,255,255,0.8) inset,
             0 -1px 0 rgba(0,0,0,0.06) inset,
             0 32px 80px rgba(99,102,241,0.15),
             0 8px 32px rgba(0,0,0,0.1),
             0 0 0 1px rgba(0,0,0,0.07);
         ">

      <!-- Window chrome -->
      <div class="flex items-center gap-0 px-4 py-3"
           style="background:linear-gradient(180deg,#F8FAFC 0%,#F1F5F9 100%);border-bottom:1px solid rgba(0,0,0,0.07);">
        <div class="flex items-center gap-2 mr-4">
          <div class="w-3.5 h-3.5 rounded-full flex items-center justify-center group/dot" style="background:#FF5F57;box-shadow:0 0 0 0.5px rgba(0,0,0,0.15);">
            <span class="opacity-0 group-hover/dot:opacity-100 text-[7px] font-black text-red-900">✕</span>
          </div>
          <div class="w-3.5 h-3.5 rounded-full" style="background:#FFBD2E;box-shadow:0 0 0 0.5px rgba(0,0,0,0.15);"></div>
          <div class="w-3.5 h-3.5 rounded-full" style="background:#28C840;box-shadow:0 0 0 0.5px rgba(0,0,0,0.15);"></div>
        </div>
        <div class="flex-1 flex items-center justify-center">
          <div class="flex items-center gap-1.5 px-3 py-1 rounded-md text-xs font-mono" style="background:rgba(0,0,0,0.05);color:#64748B;max-width:260px;">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#6366F1" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
            <span class="truncate">coordrutas.saastreria.cloud</span>
          </div>
        </div>
        <div class="flex items-center gap-1.5 text-xs font-mono text-green-600">
          <span class="w-1.5 h-1.5 rounded-full bg-green-500 live-dot"></span>
          LIVE
        </div>
      </div>

      <!-- Imagen -->
      <div class="relative overflow-hidden">
        <img src="/mockup-rutas.jpg"
             alt="CoordRutas — dashboard logístico en tiempo real"
             class="w-full block object-cover"
             style="aspect-ratio:16/9;"
             loading="eager" decoding="async"/>
      </div>

      <!-- Status bar -->
      <div class="flex items-center gap-3 px-4 py-2.5" style="background:#F8FAFC;border-top:1px solid rgba(0,0,0,0.06);">
        <span class="text-xs font-mono flex-1" style="color:#6366F1;" id="hero-typing-mac"></span>
        <span class="typing-cursor text-xs font-mono" style="color:#8B5CF6;">|</span>
        <span class="ml-auto text-xs font-mono text-[#94A3B8]">Python 3.12 · Prod</span>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10 flex flex-col items-center gap-1.5 opacity-25">
    <span class="text-[10px] font-mono tracking-widest uppercase text-[#94A3B8]">scroll</span>
    <div class="animate-bounce">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#0F0F1A" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
    </div>
  </div>
</section>

<style>
  @keyframes floatBadge {
    0%,100% { transform:translateY(0px); }
    50%      { transform:translateY(-8px); }
  }
  .hero-mac-window { transition: transform 0.6s cubic-bezier(0.23,1,0.32,1), box-shadow 0.6s ease; }
  .hero-mac-window:hover {
    transform: perspective(1200px) rotateX(1.5deg) rotateY(0deg) !important;
    box-shadow:
      0 2px 0 rgba(255,255,255,0.8) inset,
      0 -1px 0 rgba(0,0,0,0.06) inset,
      0 50px 120px rgba(99,102,241,0.2),
      0 12px 40px rgba(0,0,0,0.12),
      0 0 0 1px rgba(0,0,0,0.07) !important;
  }
</style>

<script>
  const lines = [
    '> Construyendo CoordRutas v2.4...',
    '> Optimización de rutas IA activa ✓',
    '> 12 vehículos en tiempo real',
    '> ETA calculado con precisión 98%',
  ];
  const el = document.getElementById('hero-typing-mac');
  if (el) {
    let li=0,ci=0,deleting=false;
    function tick() {
      const line = lines[li % lines.length];
      if (!deleting) {
        el.textContent = line.slice(0,++ci);
        if (ci>=line.length){ deleting=true; setTimeout(tick,2200); return; }
      } else {
        el.textContent = line.slice(0,--ci);
        if (ci===0){ deleting=false; li++; setTimeout(tick,500); return; }
      }
      setTimeout(tick, deleting?28:48);
    }
    setTimeout(tick, 1200);
  }
</script>
