---
---
<section class="relative min-h-screen flex items-center justify-center overflow-hidden bg-grid pt-16">
  <!-- Radial glow top right -->
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute top-0 right-0 w-[700px] h-[700px] rounded-full"
         style="background: radial-gradient(ellipse, rgba(99,102,241,0.12) 0%, transparent 70%);">
    </div>
    <div class="absolute bottom-0 left-0 w-[500px] h-[500px] rounded-full"
         style="background: radial-gradient(ellipse, rgba(245,158,11,0.06) 0%, transparent 70%);">
    </div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-6 py-24 grid lg:grid-cols-2 gap-16 items-center">

    <!-- Left: copy -->
    <div>
      <!-- Badge -->
      <div class="animate-fade-up delay-1 inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-[#6366F1]/30 bg-[#6366F1]/10 text-[#6366F1] text-xs font-medium mb-6">
        <span class="w-1.5 h-1.5 rounded-full bg-[#6366F1] animate-pulse"></span>
        Colombia ✦ LATAM — Ingeniería de IA para Empresas
      </div>

      <!-- H1 -->
      <h1 class="animate-fade-up delay-2 text-4xl sm:text-5xl lg:text-6xl font-extrabold leading-[1.1] tracking-tight mb-6" style="font-family: 'Plus Jakarta Sans', sans-serif;">
        La firma de IA que entrega en
        <span class="gradient-text"> semanas</span>
        <br />lo que otros tardan meses.
      </h1>

      <!-- Subheadline -->
      <p class="animate-fade-up delay-3 text-lg text-[#94A3B8] max-w-lg mb-10 leading-relaxed">
        RAG enterprise, Text-to-SQL, modernización de legacy y data pipelines — ejecutados por un equipo donde <strong class="text-[#F59E0B]">1 ingeniero + IA produce como 3 tradicionales.</strong>
      </p>

      <!-- CTAs -->
      <div class="animate-fade-up delay-4 flex flex-col sm:flex-row gap-4">
        <a
          href="#diagnostico"
          class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-[#6366F1] hover:bg-[#4F46E5] text-white font-semibold transition-all hover:shadow-[0_0_30px_rgba(99,102,241,0.4)] hover:-translate-y-0.5"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M8 2v4M16 2v4M3 10h18M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z"/>
          </svg>
          Agenda diagnóstico gratuito
        </a>
        <a
          href="#servicios"
          class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl border border-white/10 text-[#94A3B8] hover:text-white hover:border-white/20 font-medium transition-all"
        >
          Ver capacidades
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>

      <!-- Metrics -->
      <div class="animate-fade-up delay-4 flex items-center gap-8 mt-12 pt-8 border-t border-white/5">
        <div>
          <p class="text-2xl font-bold text-white" style="font-family: 'Plus Jakarta Sans', sans-serif;">3x</p>
          <p class="text-xs text-[#94A3B8] mt-0.5">velocidad de entrega</p>
        </div>
        <div class="w-px h-8 bg-white/10"></div>
        <div>
          <p class="text-2xl font-bold text-white" style="font-family: 'Plus Jakarta Sans', sans-serif;">10</p>
          <p class="text-xs text-[#94A3B8] mt-0.5">ingenieros AI/Data</p>
        </div>
        <div class="w-px h-8 bg-white/10"></div>
        <div>
          <p class="text-2xl font-bold text-white" style="font-family: 'Plus Jakarta Sans', sans-serif;">LATAM</p>
          <p class="text-xs text-[#94A3B8] mt-0.5">Colombia · México · CA</p>
        </div>
      </div>
    </div>

    <!-- Right: code mockup -->
    <div class="hidden lg:block animate-fade-up delay-3">
      <div class="glass rounded-2xl p-1 shadow-[0_0_60px_rgba(99,102,241,0.15)]">
        <!-- Window bar -->
        <div class="flex items-center gap-2 px-4 py-3 border-b border-white/5">
          <div class="w-3 h-3 rounded-full bg-red-500/70"></div>
          <div class="w-3 h-3 rounded-full bg-yellow-500/70"></div>
          <div class="w-3 h-3 rounded-full bg-green-500/70"></div>
          <span class="ml-3 text-xs text-[#475569] font-mono">saastreria — rag_engine.py</span>
        </div>
        <!-- Code -->
        <pre class="p-5 text-xs leading-relaxed overflow-hidden" style="font-family: 'JetBrains Mono', monospace;"><code><span class="text-[#94A3B8]"># Enterprise RAG sobre BigQuery</span>
<span class="text-[#6366F1]">from</span> <span class="text-[#F8FAFC]">saastreria</span> <span class="text-[#6366F1]">import</span> <span class="text-[#F8FAFC]">RAGEngine, DataLake</span>

<span class="text-[#6366F1]">engine</span> <span class="text-white">=</span> <span class="text-[#F59E0B]">RAGEngine</span><span class="text-white">(</span>
  <span class="text-[#94A3B8]">source</span><span class="text-white">=</span><span class="text-[#F59E0B]">DataLake</span><span class="text-white">.</span><span class="text-[#F8FAFC]">bigquery</span><span class="text-white">(</span><span class="text-green-400">"company-data"</span><span class="text-white">),</span>
  <span class="text-[#94A3B8]">permissions</span><span class="text-white">=</span><span class="text-[#F8FAFC]">row_level_security</span><span class="text-white">,</span>
  <span class="text-[#94A3B8]">model</span><span class="text-white">=</span><span class="text-green-400">"claude-sonnet-4-6"</span>
<span class="text-white">)</span>

<span class="text-[#94A3B8]"># El CEO pregunta en español</span>
<span class="text-[#6366F1]">answer</span> <span class="text-white">=</span> <span class="text-[#F8FAFC]">engine</span><span class="text-white">.</span><span class="text-[#6366F1]">query</span><span class="text-white">(</span>
  <span class="text-green-400">"¿Cuál fue nuestra región con mayor"</span>
  <span class="text-green-400">"  crecimiento este trimestre?"</span>
<span class="text-white">)</span>

<span class="text-[#94A3B8]"># Respuesta en segundos, no días</span>
<span class="text-[#6366F1]">print</span><span class="text-white">(</span><span class="text-[#F8FAFC]">answer</span><span class="text-white">.</span><span class="text-[#F8FAFC]">result</span><span class="text-white">)</span>
<span class="text-[#475569]"># → "Región Andina: +34% vs Q2..."</span>
</code></pre>
        <!-- Status bar -->
        <div class="flex items-center justify-between px-4 py-2 border-t border-white/5">
          <span class="text-xs text-[#475569] font-mono">Python 3.12</span>
          <span class="flex items-center gap-1.5 text-xs text-green-400 font-mono">
            <span class="w-1.5 h-1.5 rounded-full bg-green-400"></span>
            Ejecutando en producción
          </span>
        </div>
      </div>
    </div>
  </div>
</section>
