---
const founders = [
  {
    name:    'Orlando Hernández Manrique',
    role:    'Fundador & CEO · Saastreria',
    photo:   '/orlando-hernandez.jpg',
    imgSize: 130,
    bio:     'Fundé Saastreria para que las empresas medianas dejen de adaptarse a software genérico. Me siento contigo a entender el proceso, defino la estrategia y acompaño la construcción hasta que la tecnología funciona en producción — a la medida del negocio, no al revés.',
    linkedin: 'https://www.linkedin.com/in/orlando-hernandez-manrique-53149110b/',
    tag:     'Estrategia · Producto · Ingeniería',
    color:   '#BFA255',
    callout: 'Cada proyecto empieza y termina bajo mi mirada: estrategia, prioridades y calidad. Sin capas intermedias entre tú y quien decide.',
  },
  {
    name:    'César Jiménez',
    role:    'Co-fundador · Saastreria',
    photo:   '/cesar-jimenez.jpg',
    imgSize: 800,
    bio:     'Construyo software que resuelve problemas operativos reales. Empecé Saastreria porque vi de primera mano cómo las empresas medianas pierden tiempo y dinero en procesos que se pueden automatizar, integrar o digitalizar — y decidí hacer algo al respecto.',
    linkedin: 'https://www.linkedin.com/in/cesarjimenezarcia/',
    tag:     'Software · IA · Datos',
    color:   '#1B3461',
    callout: 'El diagnóstico inicial lo hago yo directamente. Sin intermediarios, sin ventas — solo una conversación honesta sobre tu proceso.',
  },
];
---

<section class="py-24 px-6 relative overflow-hidden" style="background:#FFFFFF;border-top:1px solid rgba(0,0,0,0.06);">

  <!-- Glow sutil de fondo -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[700px] h-[300px]"
         style="background:radial-gradient(ellipse at 50% 0%,rgba(27,52,97,0.05) 0%,transparent 65%);"></div>
  </div>

  <div class="max-w-5xl mx-auto relative z-10">

    <!-- Header -->
    <div class="text-center mb-16 scroll-reveal">
      <span class="eyebrow mb-4">Quiénes somos</span>
      <h2 class="text-3xl sm:text-4xl font-extrabold mb-5 mt-6 leading-[1.1]"
          style="font-family:'Plus Jakarta Sans',sans-serif;color:#0F0F1A;">
        Personas reales que entienden<br/>
        <span class="gradient-text">la operación de tu empresa.</span>
      </h2>
      <p class="text-[#374151] max-w-lg mx-auto text-base leading-relaxed">
        No somos una agencia anónima. Somos fundadores con experiencia directa en procesos empresariales — y sabemos exactamente qué significa tener un flujo roto o un sistema que no comunica con otro.
      </p>
    </div>

    <!-- Founder cards -->
    <div class={`flex flex-col gap-8 justify-center ${founders.length > 1 ? 'lg:flex-row items-stretch' : 'items-center'}`}>
      {founders.map((f, i) => (
        <div class="commercial-card rounded-2xl p-8 scroll-reveal max-w-xl w-full flex-1 group hover:-translate-y-1 transition-all duration-300 hover:shadow-[0_12px_40px_rgba(27,52,97,0.1)]"
             style={`transition-delay:${i*0.1}s;`}>

          <div class="flex flex-col sm:flex-row gap-6 items-start">

            <!-- Foto -->
            <div class="relative flex-shrink-0">
              <img
                src={f.photo}
                alt={`Foto de ${f.name}`}
                width={f.imgSize}
                height={f.imgSize}
                class="w-20 h-20 rounded-2xl object-cover"
                style="box-shadow:0 4px 16px rgba(0,0,0,0.12);"
                loading="lazy"
              />
              <!-- Punto activo -->
              <span class="absolute -bottom-1.5 -right-1.5 w-4 h-4 rounded-full bg-white border-2 border-white flex items-center justify-center"
                    style="box-shadow:0 2px 6px rgba(0,0,0,0.1);">
                <span class="w-2 h-2 rounded-full bg-green-500 live-dot"></span>
              </span>
            </div>

            <!-- Info -->
            <div class="flex-1 min-w-0">
              <div class="flex items-start justify-between gap-3 mb-1 flex-wrap">
                <div>
                  <h3 class="font-extrabold text-lg text-[#0F0F1A] leading-tight"
                      style="font-family:'Plus Jakarta Sans',sans-serif;">{f.name}</h3>
                  <p class="text-sm font-semibold mt-0.5" style={`color:${f.color};`}>{f.role}</p>
                </div>
                <!-- LinkedIn -->
                <a href={f.linkedin} target="_blank" rel="noopener noreferrer"
                   class="flex-shrink-0 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold transition-all hover:-translate-y-0.5"
                   style="background:#EBF3FB;color:#0A66C2;border:1px solid rgba(10,102,194,0.15);"
                   aria-label={`LinkedIn de ${f.name}`}>
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
                    <rect x="2" y="9" width="4" height="12"/>
                    <circle cx="4" cy="4" r="2"/>
                  </svg>
                  LinkedIn
                </a>
              </div>

              <!-- Tag -->
              <span class="inline-block px-2 py-0.5 rounded-full text-xs font-medium mb-3 mt-2"
                    style={`background:${f.color}0C;border:1px solid ${f.color}20;color:${f.color};`}>
                {f.tag}
              </span>

              <!-- Bio -->
              <p class="text-sm text-[#374151] leading-relaxed">{f.bio}</p>
            </div>
          </div>

          <!-- Footer callout -->
          <div class="mt-6 pt-5 border-t flex items-center gap-3" style="border-color:rgba(0,0,0,0.07);">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#1B3461" stroke-width="2" stroke-linecap="round">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
            </svg>
            <p class="text-xs text-[#64748B]">
              {f.callout}
            </p>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
