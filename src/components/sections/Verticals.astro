---
import { verticals } from '../../data/services';

const icons: Record<string, string> = {
  'Logística':               `<path d="M1 3h15v13H1z"/><path d="M16 8h4l3 3v5h-7V8z" stroke-linecap="round" stroke-linejoin="round"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>`,
  'Manufactura':             `<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9 1.65 1.65 0 0 0 4.27 7.18l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>`,
  'Servicios empresariales': `<rect x="3" y="9" width="18" height="12" rx="1"/><path d="M7 9V5a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v4"/><path d="M3 13h18"/>`,
  'Salud y SST':             `<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12h6M12 9v6" stroke-linecap="round"/>`,
  'Finanzas y seguros':      `<polyline points="23 6 13.5 15.5 8.5 10.5 1 18" stroke-linecap="round" stroke-linejoin="round"/><polyline points="17 6 23 6 23 12" stroke-linecap="round" stroke-linejoin="round"/>`,
};
---

<section id="verticales" class="py-14 px-6" style="background:#FFFFFF;border-top:1px solid rgba(0,0,0,0.06);">
  <div class="max-w-5xl mx-auto">

    <p class="text-center text-xs text-[#94A3B8] uppercase tracking-widest font-semibold mb-8">
      Sectores que atendemos
    </p>

    <div class="flex flex-wrap justify-center gap-3">
      {verticals.map(v => {
        const icon = icons[v.name] ?? icons['Servicios empresariales'];
        return (
          <a href={v.href}
             class="commercial-card rounded-xl px-5 py-3 min-h-12 flex items-center gap-2.5 hover:border-[rgba(27,52,97,0.22)] hover:-translate-y-0.5 hover:shadow-md transition-all duration-200 group">
            <span class="w-7 h-7 rounded-lg flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform"
                  style="background:rgba(27,52,97,0.07);border:1px solid rgba(27,52,97,0.12);" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#1B3461" stroke-width="1.8" set:html={icon}/>
            </span>
            <span class="text-sm font-medium text-[#374151] group-hover:text-[#0F0F1A] transition-colors">{v.name}</span>
          </a>
        );
      })}
    </div>

  </div>
</section>
