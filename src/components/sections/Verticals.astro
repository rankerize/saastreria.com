---
import { verticals } from '../../data/services';
---
<section id="verticales" class="py-16 px-6" style="background:#F8FAFC;border-top:1px solid rgba(0,0,0,0.06);">
  <div class="max-w-7xl mx-auto">
    <p class="text-center text-xs text-[#94A3B8] uppercase tracking-widest font-medium mb-8">
      Sectores que atendemos
    </p>
    <div class="flex flex-wrap justify-center gap-4">
      {verticals.map(v => (
        <a href={v.href} class="commercial-card rounded-xl px-6 py-3 min-h-12 flex items-center gap-3 hover:border-[rgba(99,102,241,0.2)] hover:shadow-sm transition-all">
          <span class="w-7 h-7 rounded-lg flex items-center justify-center" style="background:rgba(99,102,241,0.07);" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#6366F1" stroke-width="1.8"><path d="M4 19V5a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v14M8 7h8M8 11h8M8 15h5"/></svg>
          </span>
          <span class="text-sm font-medium text-[#374151]">{v.name}</span>
        </a>
      ))}
    </div>
  </div>
</section>
