---
import { verticals } from '../../data/services';
---
<section id="verticales" class="py-16 px-6 bg-[#111118]">
  <div class="max-w-7xl mx-auto">
    <p class="text-center text-xs text-[#475569] uppercase tracking-widest font-medium mb-8">
      Sectores que atendemos
    </p>
    <div class="flex flex-wrap justify-center gap-4">
      {verticals.map(v => (
        <div class="glass rounded-xl px-6 py-3 flex items-center gap-3 hover:border-white/20 transition-all">
          <span class="text-xl">{v.icon}</span>
          <span class="text-sm font-medium text-[#94A3B8]">{v.name}</span>
        </div>
      ))}
    </div>
  </div>
</section>
