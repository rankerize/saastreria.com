---
const steps = [
  {
    n: '01', title: 'Diagnóstico',
    color: '#1B3461',
    desc: 'Entendemos la operación, los sistemas y los objetivos reales del negocio antes de escribir una sola línea de código.',
    detail: 'Sesión de diagnóstico gratuita · mapeo de procesos · identificación del punto de partida ideal',
    icon: `<path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/>`,
  },
  {
    n: '02', title: 'Datos',
    color: '#2563EB',
    desc: 'Centralizamos y estructuramos las fuentes de información dispersas en una arquitectura de datos limpia y gobernada.',
    detail: 'Data warehouse · pipelines · calidad de datos · fuentes unificadas',
    icon: `<ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/>`,
  },
  {
    n: '03', title: 'Software',
    color: '#0EA5E9',
    desc: 'Diseñamos y construimos el sistema a la medida del proceso real. Sin código genérico, sin plantillas, sin compromisos.',
    detail: 'Aplicaciones web · APIs · módulos empresariales · integración de sistemas legacy',
    icon: `<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>`,
  },
  {
    n: '04', title: 'Inteligencia',
    color: '#F59E0B',
    desc: 'Incorporamos IA y automatización inteligente donde genera valor real y demostrable para el negocio.',
    detail: 'RAG empresarial · agentes de IA · análisis predictivo · Text-to-SQL',
    icon: `<path d="M12 2a8 8 0 018 8c0 3.5-2 6.5-5 8l-3 .9-3-.9c-3-1.5-5-4.5-5-8a8 8 0 018-8z"/><circle cx="12" cy="10" r="3"/>`,
  },
  {
    n: '05', title: 'Flujos',
    color: '#10B981',
    desc: 'Conectamos procesos y sistemas para que la operación funcione de forma integrada, sin fricción ni intervención manual.',
    detail: 'Automatización de procesos · workflows · notificaciones · triggers automáticos',
    icon: `<path d="M22 12h-4l-3 9L9 3l-3 9H2"/>`,
  },
  {
    n: '06', title: 'Control',
    color: '#06B6D4',
    desc: 'Monitoreo en tiempo real, alertas y gobierno de datos para que nada quede sin visibilidad ni trazabilidad.',
    detail: 'Dashboards de control · alertas · logs · auditoría · SLAs',
    icon: `<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/>`,
  },
  {
    n: '07', title: 'Reportes',
    color: '#BFA255',
    desc: 'Decisiones basadas en datos reales en tiempo real. No en Excel del mes pasado, no en intuición.',
    detail: 'BI empresarial · reportes automáticos · KPIs en tiempo real · visualización ejecutiva',
    icon: `<line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/>`,
  },
];

const stepsJson = JSON.stringify(steps);
---

<section class="py-28 px-6 relative overflow-hidden" style="background:#FFFFFF;border-top:1px solid rgba(0,0,0,0.06);border-bottom:1px solid rgba(0,0,0,0.06);">

  <!-- Sutil decoración -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[900px] h-[400px] rounded-full"
         style="background:radial-gradient(ellipse,rgba(27,52,97,0.05) 0%,transparent 70%);"></div>
  </div>

  <div class="max-w-6xl mx-auto relative z-10">

    <!-- Header -->
    <div class="text-center mb-20 scroll-reveal">
      <span class="eyebrow mb-6">Nuestra metodología</span>
      <h2 class="text-4xl sm:text-5xl font-extrabold mt-6 mb-5 leading-[1.1]" style="font-family:'Plus Jakarta Sans',sans-serif;color:#0F0F1A;">
        Del diagnóstico al resultado.<br/>
        <span class="gradient-text">Un proceso claro y medible.</span>
      </h2>
      <p class="text-[#374151] max-w-xl mx-auto text-lg">
        Seguimos siete pasos que transforman la operación. Nada de genéricos — cada fase se adapta al negocio real.
      </p>
    </div>

    <!-- ══ TRACK + PANEL ANIMADO ══ -->
    <div class="scroll-reveal">

      <!-- Track de pasos -->
      <div class="relative flex items-start justify-between mb-10 px-4" id="step-track">

        <!-- Línea de fondo -->
        <div class="absolute left-[5%] right-[5%] h-0.5 rounded-full top-9 z-0" style="background:rgba(0,0,0,0.07);"></div>
        <!-- Línea de progreso -->
        <div id="track-progress" class="absolute left-[5%] h-0.5 rounded-full top-9 z-0"
             style="width:0%;background:linear-gradient(90deg,#1B3461,#2563EB,#0EA5E9,#10B981,#BFA255,#F59E0B);transition:width 0.6s cubic-bezier(0.16,1,0.3,1);"></div>

        <!-- Step circles -->
        {steps.map((s, i) => (
          <button
            class="step-btn flex flex-col items-center gap-2.5 relative z-10 group/step flex-1"
            data-idx={i}
            aria-label={`Paso ${s.n}: ${s.title}`}
          >
            <!-- Círculo -->
            <div
              class="step-circle w-[68px] h-[68px] rounded-2xl flex flex-col items-center justify-center border-2 transition-all duration-500 relative mx-auto bg-white"
              style={`border-color:${s.color}25;`}
              data-color={s.color}
            >
              <span class="text-[9px] font-black font-mono tracking-widest mb-1 opacity-40" style={`color:${s.color};`}>{s.n}</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                   stroke={s.color} stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"
                   set:html={s.icon}/>
              <div class="step-ring absolute inset-0 rounded-2xl opacity-0 transition-all duration-500"
                   style={`box-shadow:0 0 0 3px ${s.color}50, 0 0 28px ${s.color}30;`}></div>
            </div>
            <!-- Título -->
            <span class="step-label text-[11px] font-semibold transition-all duration-300 text-[#94A3B8]"
                  style="font-family:'Plus Jakarta Sans',sans-serif;">{s.title}</span>
          </button>
        ))}
      </div>

      <!-- Panel featured del paso activo -->
      <div class="relative rounded-3xl overflow-hidden" id="step-panel"
           style="background:#FFFFFF;border:1px solid rgba(0,0,0,0.1);box-shadow:0 4px 24px rgba(0,0,0,0.08),0 1px 3px rgba(0,0,0,0.06);">

        <!-- Glow de color del paso activo -->
        <div id="panel-glow" class="absolute inset-0 pointer-events-none transition-all duration-700 opacity-40"
             style="background:radial-gradient(ellipse at 50% 0%,rgba(27,52,97,0.12) 0%,transparent 60%);"></div>

        <!-- Contenido animado -->
        <div id="step-content" class="relative z-10 p-10 sm:p-14 flex flex-col sm:flex-row gap-10 items-center">

          <!-- Icono grande -->
          <div id="panel-icon-wrap" class="flex-shrink-0 w-[96px] h-[96px] rounded-3xl flex items-center justify-center border-2 transition-all duration-700"
               style="background:rgba(27,52,97,0.08);border-color:rgba(27,52,97,0.22);">
            <svg id="panel-icon" width="44" height="44" viewBox="0 0 24 24" fill="none"
                 stroke="#1B3461" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/>
            </svg>
          </div>

          <!-- Texto -->
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-3 mb-3">
              <span id="panel-num" class="text-xs font-black font-mono tracking-widest" style="color:#1B3461;">PASO 01 DE 07</span>
              <div class="flex items-center gap-1.5 ml-auto" id="nav-dots">
                {steps.map((_, i) => (
                  <div class="nav-dot rounded-full transition-all duration-300 cursor-pointer" data-idx={i}
                       style="width:6px;height:6px;background:rgba(0,0,0,0.1);"></div>
                ))}
              </div>
            </div>
            <h3 id="panel-title" class="text-3xl font-extrabold text-[#0F0F1A] mb-3"
                style="font-family:'Plus Jakarta Sans',sans-serif;">Diagnóstico</h3>
            <p id="panel-desc" class="text-[#374151] text-base leading-relaxed mb-4">
              Entendemos la operación, los sistemas y los objetivos reales del negocio antes de escribir una sola línea de código.
            </p>
            <p id="panel-detail" class="text-sm font-medium" style="color:#1B3461;">
              Sesión de diagnóstico gratuita · mapeo de procesos · identificación del punto de partida ideal
            </p>
          </div>

          <!-- Flechas nav -->
          <div class="flex flex-col gap-2 flex-shrink-0">
            <button id="btn-prev" class="w-10 h-10 rounded-xl border bg-white hover:bg-[#F8FAFC] flex items-center justify-center transition-all text-[#374151]" style="border-color:rgba(0,0,0,0.1);" aria-label="Paso anterior">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 19l-7-7 7-7"/></svg>
            </button>
            <button id="btn-next" class="w-10 h-10 rounded-xl border bg-white hover:bg-[#F8FAFC] flex items-center justify-center transition-all text-[#374151]" style="border-color:rgba(0,0,0,0.1);" aria-label="Paso siguiente">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 5l7 7-7 7"/></svg>
            </button>
          </div>
        </div>

        <!-- Barra de progreso automática -->
        <div class="h-0.5 w-full" style="background:rgba(0,0,0,0.05);">
          <div id="auto-progress" class="h-full rounded-full" style="width:0%;"></div>
        </div>
      </div>

      <!-- Resultado -->
      <div class="flex justify-center mt-8">
        <div class="inline-flex items-center gap-3 px-6 py-3 rounded-2xl border"
             style="background:rgba(245,158,11,0.06);border-color:rgba(245,158,11,0.2);">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#D97706" stroke-width="2.5" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          <span class="text-sm font-semibold" style="color:#D97706;">Resultado: una operación integrada, medible y escalable</span>
        </div>
      </div>
    </div>

    <!-- ══ PRINCIPIOS ══ -->
    <div class="grid sm:grid-cols-3 gap-6 mt-24">
      {[
        { n:'01', title:'Implementación progresiva', desc:'Construimos primero un módulo útil y medible. Lo ampliamos con evidencia real, no con suposiciones.', color:'#1B3461' },
        { n:'02', title:'Transparencia total',       desc:'Cada decisión de arquitectura, seguridad e integración queda documentada y es completamente tuya.', color:'#2563EB' },
        { n:'03', title:'Acompañamiento continuo',   desc:'La solución evoluciona junto con los procesos y el equipo. No desaparecemos después del deploy.', color:'#BFA255' },
      ].map((p, i) => (
        <div class="commercial-card rounded-2xl p-7 scroll-reveal group hover:-translate-y-1 transition-all duration-300" style={`transition-delay:${i*0.1}s;`}>
          <span class="inline-flex w-10 h-10 rounded-xl items-center justify-center text-xs font-black font-mono mb-5 group-hover:scale-110 transition-transform"
                style={`background:${p.color}0C;border:1px solid ${p.color}22;color:${p.color};`}>
            {p.n}
          </span>
          <h3 class="font-bold text-[#0F0F1A] mb-2 text-sm" style="font-family:'Plus Jakarta Sans',sans-serif;">{p.title}</h3>
          <p class="text-sm leading-relaxed text-[#374151]">{p.desc}</p>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .step-btn.is-active .step-circle { transform: scale(1.12); border-width: 2px; }
  .step-btn.is-active .step-circle .step-ring { opacity: 1 !important; animation: glowRing 1.8s ease-in-out infinite; }
  .step-btn.is-active .step-label { color: #0F0F1A !important; font-weight: 700; }
  .step-btn.is-done .step-label   { color: #64748B !important; }

  @keyframes glowRing {
    0%,100% { opacity: 0.7; transform: scale(1); }
    50%      { opacity: 1;   transform: scale(1.04); }
  }
</style>

<script define:vars={{ stepsJson }}>
  const steps = JSON.parse(stepsJson);
  const DURATION = 4200;
  let current = 0;
  let progressAnim = null;

  const trackProgress  = document.getElementById('track-progress');
  const panelGlow      = document.getElementById('panel-glow');
  const panelIconWrap  = document.getElementById('panel-icon-wrap');
  const panelIcon      = document.getElementById('panel-icon');
  const panelNum       = document.getElementById('panel-num');
  const panelTitle     = document.getElementById('panel-title');
  const panelDesc      = document.getElementById('panel-desc');
  const panelDetail    = document.getElementById('panel-detail');
  const autoProgress   = document.getElementById('auto-progress');
  const stepContent    = document.getElementById('step-content');
  const stepBtns       = document.querySelectorAll('.step-btn');
  const navDots        = document.querySelectorAll('.nav-dot');
  const btnPrev        = document.getElementById('btn-prev');
  const btnNext        = document.getElementById('btn-next');

  function activate(idx) {
    current = idx;
    const s = steps[idx];

    const pct = idx === 0 ? 0 : (idx / (steps.length - 1)) * 100;
    if (trackProgress) trackProgress.style.width = pct + '%';

    stepBtns.forEach((btn, i) => {
      btn.classList.toggle('is-active', i === idx);
      btn.classList.toggle('is-done',   i < idx);
      const circle = btn.querySelector('.step-circle');
      const ring   = btn.querySelector('.step-ring');
      const label  = btn.querySelector('.step-label');
      if (!circle || !ring || !label) return;

      if (i === idx) {
        circle.style.background      = s.color + '14';
        circle.style.borderColor     = s.color;
        circle.style.boxShadow       = `0 0 0 4px ${s.color}18`;
        ring.style.opacity           = '1';
      } else if (i < idx) {
        circle.style.background      = steps[i].color + '0A';
        circle.style.borderColor     = steps[i].color + '30';
        circle.style.boxShadow       = '';
        ring.style.opacity           = '0';
      } else {
        circle.style.background      = 'white';
        circle.style.borderColor     = steps[i].color + '20';
        circle.style.boxShadow       = '';
        ring.style.opacity           = '0';
      }
    });

    navDots.forEach((dot, i) => {
      dot.style.width      = i === idx ? '20px' : '6px';
      dot.style.height     = '6px';
      dot.style.background = i === idx ? s.color : (i < idx ? s.color + '40' : 'rgba(0,0,0,0.1)');
      dot.style.borderRadius = '999px';
    });

    if (panelGlow) panelGlow.style.background =
      `radial-gradient(ellipse at 50% 0%,${s.color}14 0%,transparent 60%)`;

    if (panelIconWrap) {
      panelIconWrap.style.background   = s.color + '0E';
      panelIconWrap.style.borderColor  = s.color + '35';
      panelIconWrap.style.boxShadow    = `0 0 28px ${s.color}14`;
    }
    if (panelIcon) {
      panelIcon.setAttribute('stroke', s.color);
      panelIcon.innerHTML = s.icon;
    }

    if (stepContent) {
      stepContent.classList.remove('step-content-anim');
      void stepContent.offsetWidth;
      stepContent.classList.add('step-content-anim');
    }
    if (panelNum)    panelNum.textContent    = `PASO ${s.n} DE 07`;
    if (panelNum)    panelNum.style.color    = s.color;
    if (panelTitle)  panelTitle.textContent  = s.title;
    if (panelDesc)   panelDesc.textContent   = s.desc;
    if (panelDetail) { panelDetail.textContent = s.detail; panelDetail.style.color = s.color; }

    startProgress(s.color);
  }

  function startProgress(color) {
    if (!autoProgress) return;
    autoProgress.style.transition = 'none';
    autoProgress.style.width = '0%';
    autoProgress.style.background = color;
    autoProgress.classList.remove('progress-running');
    void autoProgress.offsetWidth;

    autoProgress.style.setProperty('--step-duration', DURATION + 'ms');
    autoProgress.classList.add('progress-running');

    clearTimeout(progressAnim);
    progressAnim = setTimeout(() => {
      const next = (current + 1) % steps.length;
      activate(next);
    }, DURATION);
  }

  btnPrev?.addEventListener('click', () => { clearTimeout(progressAnim); activate((current - 1 + steps.length) % steps.length); });
  btnNext?.addEventListener('click', () => { clearTimeout(progressAnim); activate((current + 1) % steps.length); });
  stepBtns.forEach((btn) => { btn.addEventListener('click', () => { clearTimeout(progressAnim); activate(Number(btn.dataset.idx)); }); });
  navDots.forEach((dot) => { dot.addEventListener('click', () => { clearTimeout(progressAnim); activate(Number(dot.dataset.idx)); }); });

  const panel = document.getElementById('step-panel');
  panel?.addEventListener('mouseenter', () => { clearTimeout(progressAnim); autoProgress?.classList.remove('progress-running'); });
  panel?.addEventListener('mouseleave', () => startProgress(steps[current].color));

  const observer = new IntersectionObserver((entries) => {
    if (entries[0].isIntersecting) { activate(0); observer.disconnect(); }
  }, { threshold: 0.3 });
  const section = document.querySelector('section.py-28');
  if (section) observer.observe(section);
</script>
