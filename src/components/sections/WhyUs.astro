---
---
<section class="py-24 px-6 bg-[#111118]">
  <div class="max-w-7xl mx-auto">
    <div class="grid lg:grid-cols-2 gap-16 items-center">

      <!-- Left: diagram -->
      <div class="relative">
        <div class="glass rounded-2xl p-8">
          <p class="text-xs text-[#475569] font-mono uppercase tracking-widest mb-6">Método de transformación Saastreria</p>

          <!-- Traditional -->
          <div class="mb-8">
            <p class="text-xs text-[#475569] mb-3 font-medium">Operación desconectada</p>
            <div class="flex gap-2">
              {[1,2,3].map(() => (
                <div class="flex-1 rounded-lg bg-[#1E293B] p-3 text-center">
                  <div class="w-8 h-8 rounded-full bg-[#334155] mx-auto mb-2 flex items-center justify-center">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#94A3B8" stroke-width="2">
                      <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
                    </svg>
                  </div>
                  <p class="text-[10px] text-[#475569]">Proceso</p>
                </div>
              ))}
            </div>
            <div class="mt-3 h-2 rounded-full bg-[#1E293B] overflow-hidden">
              <div class="h-full w-1/3 bg-[#334155] rounded-full"></div>
            </div>
            <p class="text-xs text-[#475569] mt-1">Información dispersa · tareas manuales · poca visibilidad</p>
          </div>

          <!-- Saastreria -->
          <div>
            <p class="text-xs text-[#6366F1] mb-3 font-medium">Sistema diseñado por Saastreria</p>
            <div class="flex gap-2 items-center">
              <div class="flex-1 rounded-lg border border-[#6366F1]/30 bg-[#6366F1]/10 p-3 text-center">
                <div class="w-8 h-8 rounded-full bg-[#6366F1]/20 mx-auto mb-2 flex items-center justify-center">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#6366F1" stroke-width="2">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
                  </svg>
                </div>
                <p class="text-[10px] text-[#6366F1]">Diagnóstico</p>
              </div>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#6366F1" stroke-width="2">
                <path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/>
              </svg>
              <div class="flex-[2] grid grid-cols-3 gap-1">
                {['Datos', 'Software', 'IA', 'Flujos', 'Control', 'Reportes'].map((label) => (
                  <div class="rounded bg-[#6366F1]/10 border border-[#6366F1]/20 py-1 px-1 text-center">
                    <p class="text-[9px] text-[#6366F1] font-mono">{label}</p>
                  </div>
                ))}
              </div>
            </div>
            <div class="mt-3 h-2 rounded-full bg-[#1E293B] overflow-hidden">
              <div class="h-full bg-gradient-to-r from-[#6366F1] to-[#F59E0B] rounded-full" style="width: 100%"></div>
            </div>
            <p class="text-xs text-[#F59E0B] mt-1 font-medium">Resultado: una operación integrada, medible y escalable</p>
          </div>
        </div>
      </div>

      <!-- Right: copy -->
      <div>
        <span class="inline-block px-3 py-1 rounded-full border border-[#F59E0B]/30 bg-[#F59E0B]/10 text-[#F59E0B] text-xs font-medium mb-4">
          Nuestro diferenciador
        </span>
        <h2 class="text-3xl sm:text-4xl font-bold mb-6 leading-tight" style="font-family: 'Plus Jakarta Sans', sans-serif;">
          Primero entendemos tu empresa.
          <span class="text-[#6366F1]"> Después construimos la solución.</span>
        </h2>
        <p class="text-[#94A3B8] mb-8 leading-relaxed">
          No instalamos una herramienta genérica sobre un proceso que no comprendemos. Analizamos la operación, definimos el mejor punto de partida y combinamos software, datos, automatización e IA según las necesidades reales del negocio.
        </p>

        <div class="space-y-4">
          {[
            { icon: '⚡', title: 'Implementación progresiva', desc: 'Construimos primero un módulo útil y medible, y lo ampliamos con evidencia.' },
            { icon: '🔍', title: 'Transparencia total', desc: 'Cada decisión de arquitectura, seguridad e integración queda documentada.' },
            { icon: '🤝', title: 'Acompañamiento continuo', desc: 'La solución evoluciona junto con los procesos y el equipo de tu empresa.' },
          ].map(item => (
            <div class="flex gap-4">
              <span class="text-xl flex-shrink-0">{item.icon}</span>
              <div>
                <p class="font-semibold text-sm text-white" style="font-family: 'Plus Jakarta Sans', sans-serif;">{item.title}</p>
                <p class="text-sm text-[#94A3B8] mt-0.5">{item.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
