---
import { faqs } from '../../data/services';
---
<section id="faq" class="py-24 px-6" style="background:#F8FAFC;">
  <div class="max-w-4xl mx-auto">
    <div class="text-center mb-16">
      <span class="eyebrow mb-4">Preguntas frecuentes</span>
      <h2 class="text-3xl sm:text-4xl font-bold mt-6 text-[#0F0F1A]" style="font-family: 'Plus Jakarta Sans', sans-serif;">
        Lo que los líderes empresariales siempre preguntan
      </h2>
    </div>

    <div class="space-y-3">
      {faqs.map((faq, i) => (
        <details class="commercial-card rounded-xl group" open={i === 0}>
          <summary class="flex items-center justify-between p-6 cursor-pointer list-none select-none">
            <span class="font-semibold text-sm text-[#0F0F1A] pr-4" style="font-family: 'Plus Jakarta Sans', sans-serif;">{faq.q}</span>
            <svg class="w-4 h-4 text-[#94A3B8] flex-shrink-0 transition-transform group-open:rotate-45" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 5v14M5 12h14"/>
            </svg>
          </summary>
          <div class="px-6 pb-6">
            <p class="text-sm text-[#64748B] leading-relaxed">{faq.a}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
