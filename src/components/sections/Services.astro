---
import { services } from '../../data/services';

const featured = services.filter(s => s.featured);
const secondary = services.filter(s => !s.featured);

const icons: Record<string, string> = {
  'brain': `<path d="M12 2C8.5 2 6 4.5 6 8c0 1.5.5 2.8 1.3 3.8C6.5 12.5 6 13.7 6 15c0 3.3 2.7 6 6 6s6-2.7 6-6c0-1.3-.5-2.5-1.3-3.2C17.5 10.8 18 9.5 18 8c0-3.5-2.5-6-6-6z"/>`,
  'message-square-code': `<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/><path d="m10 10-2 2 2 2"/><path d="m14 10 2 2-2 2"/>`,
  'zap': `<polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>`,
  'shield-check': `<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/>`,
  'refresh-cw': `<path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M8 16H3v5"/>`,
  'plug': `<path d="M12 22v-5"/><path d="M9 8V2"/><path d="M15 8V2"/><path d="M18 8v5a4 4 0 0 1-4 4h-4a4 4 0 0 1-4-4V8z"/>`,
  'cpu': `<rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><path d="M15 2v2M9 2v2M2 15h2M2 9h2M15 22v-2M9 22v-2M22 15h-2M22 9h-2"/>`,
  'dollar-sign': `<line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>`,
};
---

<section id="servicios" class="py-24 px-6">
  <div class="max-w-7xl mx-auto">

    <!-- Header -->
    <div class="text-center mb-16">
      <span class="inline-block px-3 py-1 rounded-full border border-[#6366F1]/30 bg-[#6366F1]/10 text-[#6366F1] text-xs font-medium mb-4">
        Capacidades
      </span>
      <h2 class="text-3xl sm:text-4xl font-bold mb-4" style="font-family: 'Plus Jakarta Sans', sans-serif;">
        Ingeniería de IA que mueve empresas
      </h2>
      <p class="text-[#94A3B8] max-w-xl mx-auto">
        Desde RAG enterprise hasta modernización de sistemas legacy — ejecutado con velocidad de agentes.
      </p>
    </div>

    <!-- Featured 3 -->
    <div class="grid md:grid-cols-3 gap-6 mb-6">
      {featured.map((s) => (
        <div class="glass rounded-2xl p-6 hover:border-[#6366F1]/30 transition-all hover:-translate-y-1 hover:shadow-[0_0_30px_rgba(99,102,241,0.1)] group relative overflow-hidden">
          <!-- Glow corner -->
          <div class="absolute top-0 right-0 w-32 h-32 rounded-full opacity-0 group-hover:opacity-100 transition-opacity"
               style="background: radial-gradient(circle, rgba(99,102,241,0.1) 0%, transparent 70%); transform: translate(30%, -30%);">
          </div>

          {s.badge && (
            <span class="inline-block px-2 py-0.5 rounded-full bg-[#F59E0B]/10 border border-[#F59E0B]/30 text-[#F59E0B] text-xs font-medium mb-4">
              {s.badge}
            </span>
          )}

          <div class="w-10 h-10 rounded-xl bg-[#6366F1]/10 border border-[#6366F1]/20 flex items-center justify-center mb-4">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#6366F1" stroke-width="1.5" set:html={icons[s.icon]} />
          </div>

          <h3 class="font-bold text-white mb-2" style="font-family: 'Plus Jakarta Sans', sans-serif;">{s.title}</h3>
          <p class="text-sm text-[#94A3B8] leading-relaxed">{s.description}</p>

          <a href={s.href} class="inline-flex items-center gap-1 mt-4 text-sm text-[#6366F1] hover:text-[#818CF8] transition-colors font-medium">
            Más info
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
      ))}
    </div>

    <!-- Secondary 4 -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {secondary.map((s) => (
        <div class="glass rounded-xl p-5 hover:border-white/15 transition-all hover:-translate-y-0.5 group">
          <div class="w-8 h-8 rounded-lg bg-white/5 flex items-center justify-center mb-3">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#94A3B8" stroke-width="1.5" set:html={icons[s.icon]} />
          </div>
          <h3 class="font-semibold text-sm text-white mb-1.5" style="font-family: 'Plus Jakarta Sans', sans-serif;">{s.title}</h3>
          <p class="text-xs text-[#475569] leading-relaxed">{s.description}</p>
        </div>
      ))}
    </div>

  </div>
</section>
