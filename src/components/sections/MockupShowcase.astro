    alt: 'Coordinador de Rutas — Dashboard logístico en tiempo real',
    title: 'Coordinador de Rutas',
    desc: 'Logística · Distribución · Última milla',
    footer: 'GPS en tiempo real · optimización con IA · trazabilidad',
    stat: '94% eficiencia',
    statColor: '#6366F1',
    accentColor: 'rgba(99,102,241,0.25)',
    iconColor: '#6366F1',
    iconBg: 'rgba(99,102,241,0.1)',
    iconBorder: 'rgba(99,102,241,0.2)',
    icon: `<path d="M3 12h3l3-9 4 18 3-9h3" stroke-linecap="round" stroke-linejoin="round"/>`,
