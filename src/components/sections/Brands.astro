---
import { clients } from '../../data/clients';

const [featured, ...rest] = clients;
---

<section id="marcas" class="py-24 px-6 relative overflow-hidden" style="background:#FFFFFF;border-top:1px solid rgba(0,0,0,0.06);">

  <!-- Glow sutil de fondo -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute top-0 left-1/3 w-[600px] h-[280px]"
         style="background:radial-gradient(ellipse at 50% 0%,rgba(191,162,85,0.06) 0%,transparent 65%);"></div>
  </div>

  <div class="max-w-7xl mx-auto relative z-10">

    <!-- Header -->
    <div class="text-center mb-14 scroll-reveal">
      <span class="eyebrow mb-4">Confían en el taller</span>
      <h2 class="text-3xl sm:text-4xl font-extrabold mb-5 mt-6 leading-[1.1]"
          style="font-family:'Plus Jakarta Sans',sans-serif;color:#0F0F1A;">
        Cada marca, con el traje<br class="hidden sm:block" />
        <span class="gradient-text">que le construimos.</span>
      </h2>
      <p class="text-[#374151] max-w-xl mx-auto text-base leading-relaxed">
        Esto no es un muro de logos: cada marca viene acompañada del software real que diseñamos para su operación.
      </p>
    </div>

    <!-- ── Bento marca × producto ── -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-6 gap-5">

      <!-- Tile principal (caso documentado) -->
      <a href={featured.href}
         class="md:col-span-2 lg:col-span-4 relative rounded-2xl p-8 sm:p-10 flex flex-col justify-between min-h-[300px] group scroll-reveal overflow-hidden transition-transform duration-300 hover:-translate-y-1"
         style="background:linear-gradient(135deg,#22456F 0%,#1B3461 55%,#152A4E 100%);box-shadow:0 12px 40px rgba(27,52,97,0.25);"
         aria-label={`${featured.name} — ${featured.product}`}>

        <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
          <div class="absolute -top-20 -right-20 w-72 h-72 rounded-full"
               style="background:radial-gradient(circle,rgba(191,162,85,0.18) 0%,transparent 70%);"></div>
        </div>

        <!-- Costura interior (hover) -->
        <div class="absolute inset-[8px] rounded-xl border border-dashed opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"
             style="border-color:rgba(191,162,85,0.55);"></div>

        <div class="relative z-10">
          <div class="flex items-start justify-between gap-4 flex-wrap mb-8">
            <img src={featured.logo} alt={`${featured.name} — logo`} class="max-h-10 w-auto" loading="lazy" />
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-semibold tracking-wide"
                  style="background:rgba(191,162,85,0.15);border:1px solid rgba(191,162,85,0.35);color:#D4B567;">
              <span class="w-1.5 h-1.5 rounded-full bg-[#D4B567] live-dot"></span>
              {featured.badge}
            </span>
          </div>
          <h3 class="text-2xl sm:text-3xl font-extrabold text-white leading-tight mb-3"
              style="font-family:'Plus Jakarta Sans',sans-serif;">
            {featured.product}
          </h3>
          <p class="text-sm text-[#A9B6CA] leading-relaxed max-w-lg">{featured.productDetail}</p>
        </div>

        <div class="relative z-10 flex items-end justify-between gap-4 mt-8">
          <span class="font-mono text-[10px] tracking-[0.2em] text-[#D4B567]">{featured.meta}</span>
          <span class="inline-flex items-center gap-2 text-xs font-semibold text-white opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300">
            Ver el caso
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </span>
        </div>
      </a>

      <!-- Tiles secundarios -->
      {rest.map((c, i) => (
        <a href={c.href}
           target={c.external ? '_blank' : undefined}
           rel={c.external ? 'noopener noreferrer' : undefined}
           class="commercial-card rounded-2xl p-7 flex flex-col justify-between min-h-[220px] group scroll-reveal hover:-translate-y-1 transition-all duration-300"
           style={`transition-delay:${(i + 1) * 0.08}s;`}
           aria-label={`${c.name} — ${c.product}`}>
          <!-- Costura interior (hover) -->
          <div class="relative rounded-2xl overflow-hidden h-full flex flex-col justify-between">
            <div class="absolute inset-[6px] rounded-xl border border-dashed opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none z-10"
                 style="border-color:rgba(191,162,85,0.6);"></div>

            <div class="flex items-start justify-between gap-3">
              <img src={c.logo} alt={`${c.name} — logo`} class="max-h-8 w-auto" loading="lazy" />
              <svg class="flex-shrink-0 opacity-0 -translate-x-1 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300 text-[#1B3461]" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                {c.external
                  ? <path d="M7 17L17 7M17 7H8M17 7v9" stroke-linejoin="round"/>
                  : <path d="M5 12h14M12 5l7 7-7 7" stroke-linejoin="round"/>}
              </svg>
            </div>

            <div class="mt-6">
              <h3 class="text-base font-bold text-[#0F0F1A] leading-snug mb-1.5"
                  style="font-family:'Plus Jakarta Sans',sans-serif;">
                {c.product}
              </h3>
              <p class="text-xs text-[#64748B] leading-relaxed mb-3">{c.productDetail}</p>
              <span class="font-mono text-[10px] tracking-[0.18em] text-[#1B3461]">{c.meta}</span>
            </div>
          </div>
        </a>
      ))}
    </div>

    <!-- ── Reseñas reales ── -->
    <div class="mt-16 grid md:grid-cols-2 lg:grid-cols-3 gap-5">

      {clients.map((c, i) => (
        <figure class="commercial-card rounded-2xl p-7 flex flex-col scroll-reveal hover:-translate-y-1 transition-all duration-300"
                style={`transition-delay:${i * 0.06}s;`}>
          <span class="text-4xl leading-none font-serif select-none" style="color:#BFA255;" aria-hidden="true">&ldquo;</span>
          <blockquote class="flex-1 text-sm text-[#374151] leading-relaxed mt-2">
            {c.review}
          </blockquote>
          <figcaption class="mt-6 pt-5 border-t flex items-center justify-between gap-3" style="border-color:rgba(0,0,0,0.07);">
            <img src={c.logo} alt={`${c.name} — logo`} class="max-h-6 w-auto" loading="lazy" />
            <div class="text-right">
              <p class="font-mono text-[11px] text-[#BFA255]">{c.reviewService}</p>
              <p class="font-mono text-[10px] text-[#94A3B8] mt-0.5">{c.reviewRole}</p>
            </div>
          </figcaption>
        </figure>
      ))}

      <!-- Tile CTA: la próxima marca -->
      <a href="/diagnostico/"
         class="rounded-2xl p-7 flex flex-col items-center justify-center text-center group scroll-reveal transition-transform duration-300 hover:-translate-y-1 min-h-[220px]"
         style="border:1.5px dashed rgba(191,162,85,0.5);background:rgba(191,162,85,0.04);"
         aria-label="Agendar diagnóstico gratuito">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#BFA255" stroke-width="1.8" stroke-linecap="round" class="mb-4 group-hover:rotate-45 transition-transform duration-500">
          <path d="M13 2L3 14h7l-1 8 10-12h-7l1-8z" stroke-linejoin="round"/>
        </svg>
        <p class="text-base font-bold text-[#0F0F1A] leading-snug mb-1.5" style="font-family:'Plus Jakarta Sans',sans-serif;">
          La próxima marca podría ser la tuya
        </p>
        <p class="text-xs text-[#64748B] mb-5">Diagnóstico gratuito de 30 minutos, con un fundador.</p>
        <span class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-semibold text-white transition-all group-hover:shadow-[0_6px_20px_rgba(27,52,97,0.35)]"
              style="background:#1B3461;">
          Empezar mi diagnóstico
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </span>
      </a>
    </div>

  </div>
</section>
