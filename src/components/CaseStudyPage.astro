---
import Base from '../layouts/Base.astro';
import Navbar from './sections/Navbar.astro';
import Footer from './sections/Footer.astro';
import type { CaseStudy } from '../data/cases';

interface Props { study: CaseStudy; }
const { study } = Astro.props;

const SITE = 'https://saastreria.cloud';
const url = new URL(`/casos-de-exito/${study.slug}/`, SITE).href;

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: study.title,
    description: study.description,
    url,
    author: { '@id': `${SITE}/#organization` },
    publisher: { '@id': `${SITE}/#organization` },
    inLanguage: 'es-CO',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE },
      { '@type': 'ListItem', position: 2, name: 'Casos de éxito', item: `${SITE}/casos-de-exito/` },
      { '@type': 'ListItem', position: 3, name: study.eyebrow, item: url },
    ],
  },
];
---

<Base title={study.seoTitle} description={study.description} canonical={`/casos-de-exito/${study.slug}/`} schemas={schemas}>
  <Navbar />
  <main id="contenido">

    <!-- ── Hero ── -->
    <section class="relative overflow-hidden bg-grid pt-32 pb-20 sm:pt-40 sm:pb-28">
      <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
        <div class="absolute -top-40 right-[-10rem] w-[40rem] h-[40rem] rounded-full bg-[#1B3461]/10 blur-3xl"></div>
        <div class="absolute bottom-0 left-[-8rem] w-[32rem] h-[32rem] rounded-full bg-[#F59E0B]/5 blur-3xl"></div>
      </div>
      <div class="section-shell relative">
        <nav aria-label="Migas de pan" class="mb-8 text-xs text-[#718096]">
          <ol class="flex flex-wrap items-center gap-2">
            <li><a href="/" class="hover:text-white transition-colors">Inicio</a></li>
            <li aria-hidden="true">/</li>
            <li><a href="/casos-de-exito/" class="hover:text-white transition-colors">Casos de éxito</a></li>
            <li aria-hidden="true">/</li>
            <li class="text-[#A9B6CA]">{study.sector}</li>
          </ol>
        </nav>

        <div class="grid lg:grid-cols-[1.1fr_.9fr] gap-14 items-start">
          <div>
            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-[#F59E0B]/30 bg-[#F59E0B]/8 mb-6">
              <span class="w-1.5 h-1.5 rounded-full bg-[#FBBF24]"></span>
              <span class="text-xs font-semibold text-[#FBBF24] tracking-wide">{study.sector}</span>
            </div>
            <h1 class="text-4xl sm:text-5xl lg:text-[3.4rem] font-extrabold leading-[1.06] tracking-tight">
              {study.title}
            </h1>
            <p class="mt-6 text-lg sm:text-xl text-[#A9B6CA] leading-relaxed max-w-2xl">
              {study.description}
            </p>
            <div class="mt-8 flex flex-wrap gap-2">
              {study.technologies.slice(0, 6).map((tech) => (
                <span class="px-3 py-1 text-xs font-medium rounded-full border border-white/10 bg-white/5 text-[#CBD5E1]">
                  {tech}
                </span>
              ))}
            </div>
          </div>

          <!-- Stat card hero -->
          <div class="commercial-card p-6 sm:p-8 space-y-4">
            <p class="text-xs uppercase tracking-[.14em] text-[#718096]">Resumen del caso</p>
            <ul class="space-y-3">
              {study.outcomes.slice(0, 3).map((outcome) => (
                <li class="flex gap-3 items-start">
                  <span class="mt-0.5 w-5 h-5 rounded-full bg-green-500/15 border border-green-500/30 flex items-center justify-center flex-shrink-0">
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#4ade80" stroke-width="2.5">
                      <path d="m5 12 4 4L19 6"/>
                    </svg>
                  </span>
                  <div>
                    <p class="text-sm font-semibold text-white">{outcome.label}</p>
                    <p class="text-xs text-[#94A3B8] leading-relaxed mt-0.5">{outcome.description}</p>
                  </div>
                </li>
              ))}
            </ul>
            <div class="pt-3 border-t border-white/8">
              <a href="/diagnostico/" class="btn-primary w-full text-center block">
                Evaluar un caso similar
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ── El reto ── -->
    <section class="py-20 sm:py-28 bg-[#0D0D14]">
      <div class="section-shell grid lg:grid-cols-[.9fr_1.1fr] gap-14 items-start">
        <div>
          <span class="eyebrow">El reto</span>
          <h2 class="mt-5 text-3xl sm:text-4xl font-bold leading-snug">
            Qué estaba pasando en la operación
          </h2>
          <p class="mt-5 text-[#A9B6CA] leading-relaxed text-lg">
            {study.challenge}
          </p>
        </div>
        <div class="space-y-3">
          {study.painPoints.map((pain, index) => (
            <div class="commercial-card p-5 flex gap-4 items-start">
              <span class="text-[#F59E0B] font-mono text-xs mt-0.5 flex-shrink-0">0{index + 1}</span>
              <p class="text-sm text-[#CBD5E1] leading-relaxed">{pain}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ── Solución: lo que construimos ── -->
    <section class="py-20 sm:py-28">
      <div class="section-shell">
        <div class="max-w-3xl mb-14">
          <span class="eyebrow">La solución</span>
          <h2 class="mt-5 text-3xl sm:text-4xl font-bold">
            {study.solutionSubtitle}
          </h2>
          <p class="mt-5 text-[#A9B6CA] leading-relaxed text-lg">
            {study.solutionLead}
          </p>
        </div>

        <div class="grid gap-5">
          {study.solutionBlocks.map((block, index) => (
            <article class={`commercial-card p-7 sm:p-9 grid sm:grid-cols-[80px_1fr] gap-6 items-start ${index % 2 === 1 ? 'lg:ml-12' : ''}`}>
              <div class="flex sm:flex-col items-center sm:items-start gap-4">
                <span class="text-4xl font-extrabold gradient-text">{block.number}</span>
                <div class="hidden sm:block w-px flex-1 bg-gradient-to-b from-[#1B3461]/40 to-transparent min-h-8"></div>
              </div>
              <div>
                <h3 class="text-xl sm:text-2xl font-bold leading-snug">{block.title}</h3>
                <p class="mt-4 text-[#A9B6CA] leading-relaxed">{block.description}</p>
                <div class="mt-5 flex flex-wrap gap-2">
                  {block.tags.map((tag) => (
                    <span class="px-3 py-1 text-xs font-medium rounded-full border border-[#1B3461]/40 bg-[#1B3461]/10 text-[#BFA255]">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ── Impacto ── -->
    <section class="py-20 sm:py-28 bg-[#0D0D14]">
      <div class="section-shell">
        <div class="max-w-3xl mb-12">
          <span class="eyebrow">Impacto</span>
          <h2 class="mt-5 text-3xl sm:text-4xl font-bold">
            Cómo cambió la operación
          </h2>
        </div>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
          {study.outcomes.map((outcome) => (
            <article class="commercial-card p-6 group">
              <div class="w-10 h-10 rounded-xl bg-green-500/10 border border-green-500/20 flex items-center justify-center mb-5">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#4ade80" stroke-width="2">
                  <path d="M13 7h8m0 0v8m0-8-8 8-4-4-6 6"/>
                </svg>
              </div>
              <h3 class="font-bold text-lg leading-snug">{outcome.label}</h3>
              <p class="mt-3 text-sm text-[#94A3B8] leading-relaxed">{outcome.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ── Tecnologías ── -->
    <section class="py-16">
      <div class="section-shell">
        <div class="commercial-card p-7 sm:p-10 flex flex-col sm:flex-row gap-8 items-start sm:items-center">
          <div class="flex-shrink-0">
            <span class="eyebrow">Tecnologías</span>
            <h2 class="mt-3 text-xl font-bold">Stack del proyecto</h2>
          </div>
          <div class="flex flex-wrap gap-2.5">
            {study.technologies.map((tech) => (
              <span class="px-4 py-2 text-sm font-medium rounded-xl border border-white/10 bg-white/5 text-[#CBD5E1]">
                {tech}
              </span>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ── CTA + Servicios relacionados ── -->
    <section class="py-20 sm:py-28 bg-[#0D0D14]">
      <div class="section-shell">
        <div class="commercial-card p-8 sm:p-12 bg-gradient-to-br from-[#1B3461]/15 via-white/[.03] to-[#F59E0B]/8 text-center mb-10">
          <span class="eyebrow">¿Tu empresa enfrenta algo similar?</span>
          <h2 class="mt-5 text-3xl sm:text-4xl font-bold">
            Hablemos del proceso antes de hablar de tecnología
          </h2>
          <p class="mt-4 text-[#A9B6CA] max-w-2xl mx-auto">
            En una sesión de diagnóstico revisamos el estado actual, los sistemas involucrados y el resultado que tiene sentido priorizar.
          </p>
          <div class="mt-8 flex flex-col sm:flex-row gap-3 justify-center">
            <a href="/diagnostico/" class="btn-primary">Solicitar diagnóstico</a>
            <a
              href="https://wa.me/573007244122?text=Hola%20Saastreria%2C%20vi%20su%20caso%20de%20comercio%20digital%20y%20quiero%20hablar%20de%20un%20proceso%20similar"
              target="_blank"
              rel="noopener"
              class="btn-secondary"
            >
              WhatsApp directo
            </a>
          </div>
        </div>

        <div>
          <h2 class="text-xl font-bold mb-5">Servicios relacionados</h2>
          <div class="flex flex-wrap gap-3">
            {study.relatedServices.map((item) => (
              <a href={item.href} class="btn-secondary text-sm">
                {item.label}
                <span aria-hidden="true">→</span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</Base>
