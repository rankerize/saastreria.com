---
const endpoint = import.meta.env.PUBLIC_SHEETS_URL || '';
---
<form id="diagnostic-form" class="commercial-card p-6 sm:p-8 space-y-5" data-endpoint={endpoint} novalidate>
  <div class="grid sm:grid-cols-2 gap-5">
    <div><label for="nombre" class="block text-sm font-bold mb-2">Nombre completo *</label><input id="nombre" name="nombre" autocomplete="name" required class="form-input" /></div>
    <div><label for="empresa" class="block text-sm font-bold mb-2">Empresa *</label><input id="empresa" name="empresa" autocomplete="organization" required class="form-input" /></div>
    <div><label for="email" class="block text-sm font-bold mb-2">Correo corporativo *</label><input id="email" name="email" type="email" autocomplete="email" required class="form-input" /></div>
    <div><label for="telefono" class="block text-sm font-bold mb-2">Teléfono o WhatsApp</label><input id="telefono" name="telefono" type="tel" autocomplete="tel" class="form-input" /></div>
  </div>
  <div><label for="desafio" class="block text-sm font-bold mb-2">¿Qué proceso o problema quieres resolver? *</label><textarea id="desafio" name="desafio" rows="5" required class="form-input resize-y" placeholder="Cuéntanos qué ocurre hoy, quiénes participan y qué te gustaría mejorar."></textarea></div>
  <div class="grid sm:grid-cols-2 gap-5">
    <div><label for="sector" class="block text-sm font-bold mb-2">Sector</label><select id="sector" name="sector" class="form-input"><option value="">Seleccionar</option><option>Logística</option><option>Manufactura</option><option>Servicios empresariales</option><option>Salud / SST</option><option>Finanzas / Seguros</option><option>Otro</option></select></div>
    <div><label for="prioridad" class="block text-sm font-bold mb-2">Prioridad</label><select id="prioridad" name="prioridad" class="form-input"><option>Explorando opciones</option><option>Próximo trimestre</option><option>Urgente</option></select></div>
  </div>
  <label class="flex items-start gap-3 text-xs text-[#94A3B8]"><input type="checkbox" name="privacidad" required class="mt-1 accent-[#6366F1]" /><span>Acepto el tratamiento de mis datos para recibir respuesta a esta solicitud. Consulta la <a href="/privacidad/" class="text-[#A5B4FC] underline">política de privacidad</a>.</span></label>
  <div id="form-status" class="hidden rounded-xl p-4 text-sm" role="status" aria-live="polite"></div>
  <button type="submit" class="btn-primary w-full sm:w-auto">Enviar solicitud</button>
  <p class="text-xs text-[#718096]">También puedes escribir a <a href="mailto:hola@saastreria.cloud" class="text-[#A5B4FC]">hola@saastreria.cloud</a>.</p>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>('#diagnostic-form');
  const status = document.querySelector<HTMLElement>('#form-status');
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form.checkValidity()) { form.reportValidity(); return; }
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const endpoint = form.dataset.endpoint;
    if (!status || !button) return;
    if (!endpoint) {
      status.className = 'rounded-xl p-4 text-sm bg-amber-500/10 border border-amber-500/25 text-amber-200';
      status.textContent = 'El envío automático aún no está disponible. Escríbenos a hola@saastreria.cloud y responderemos tu solicitud.';
      return;
    }
    button.disabled = true; button.textContent = 'Enviando…';
    try {
      const payload = Object.fromEntries(new FormData(form).entries());
      await fetch(endpoint, { method: 'POST', mode: 'no-cors', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
      status.className = 'rounded-xl p-4 text-sm bg-green-500/10 border border-green-500/25 text-green-200';
      status.textContent = 'Recibimos tu solicitud. Nuestro equipo te contactará para coordinar el diagnóstico.';
      form.reset();
    } catch {
      status.className = 'rounded-xl p-4 text-sm bg-red-500/10 border border-red-500/25 text-red-200';
      status.textContent = 'No pudimos enviar la solicitud. Inténtalo de nuevo o escríbenos por correo.';
    } finally { button.disabled = false; button.textContent = 'Enviar solicitud'; }
  });
</script>
