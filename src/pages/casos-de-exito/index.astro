---
import Base from '../../layouts/Base.astro'; import Navbar from '../../components/sections/Navbar.astro'; import Footer from '../../components/sections/Footer.astro';
---
<Base title="Casos de éxito y demostraciones | Saastreria" description="Conoce cómo abordamos problemas empresariales de software, datos y automatización. Los casos verificables se publican con autorización del cliente." canonical="/casos-de-exito/">
  <Navbar /><main id="contenido"><section class="pt-36 pb-20 bg-grid"><div class="section-shell max-w-4xl"><span class="eyebrow">Evidencia</span><h1 class="mt-6 text-4xl sm:text-6xl font-extrabold">Resultados que se puedan demostrar</h1><p class="mt-6 text-xl text-[#A9B6CA] leading-relaxed">No publicamos cifras ni nombres de clientes sin autorización. Esta sección reunirá casos verificados con contexto, proceso, alcance y resultados medidos.</p></div></section><section class="py-20 bg-[#0D0D14]"><div class="section-shell"><div class="commercial-card p-8 sm:p-12 grid lg:grid-cols-2 gap-10"><div><span class="eyebrow">Cómo documentamos un caso</span><h2 class="mt-5 text-3xl font-bold">Problema, intervención y evidencia</h2></div><div class="space-y-4">{['Situación inicial y restricciones', 'Decisiones de arquitectura y proceso', 'Implementación por etapas', 'Métricas antes y después', 'Aprendizajes y próximos pasos'].map((item, i) => <div class="flex gap-4"><span class="text-[#818CF8] font-mono">0{i + 1}</span><span class="text-[#CBD5E1]">{item}</span></div>)}</div></div></div></section><section class="py-20 text-center"><h2 class="text-3xl font-bold">¿Quieres evaluar un caso de tu empresa?</h2><a href="/diagnostico/" class="btn-primary mt-8">Conversar con el equipo</a></section></main><Footer />
</Base>
