---
import Base from '../layouts/Base.astro';
import Navbar from '../components/sections/Navbar.astro';
import Hero from '../components/sections/Hero.astro';
import Stats from '../components/sections/Stats.astro';
import TechBanner from '../components/sections/TechBanner.astro';
import Services from '../components/sections/Services.astro';
import MockupShowcase from '../components/sections/MockupShowcase.astro';
import WhyUs from '../components/sections/WhyUs.astro';
import Products from '../components/sections/Products.astro';
import Verticals from '../components/sections/Verticals.astro';
import Founders from '../components/sections/Founders.astro';
import StitchClosure from '../components/sections/StitchClosure.astro';
import FAQ from '../components/sections/FAQ.astro';
import Footer from '../components/sections/Footer.astro';
import DiagnosticBot from '../components/ui/DiagnosticBot';
---

<Base>
  <!-- Scroll progress bar -->
  <div id="scroll-progress"></div>

  <!-- ── Hilo que se teje (visible en xl+) ── -->
  <div id="stitch-thread" aria-hidden="true" style="
    position:fixed;left:16px;top:0;bottom:0;width:22px;
    z-index:40;pointer-events:none;
    display:none;
  ">
    <!-- Puntadas de fondo (guía, más visible) -->
    <div style="
      position:absolute;top:0;bottom:0;left:9px;width:2px;
      background:repeating-linear-gradient(
        to bottom,
        rgba(191,162,85,0.18) 0px, rgba(191,162,85,0.18) 7px,
        transparent 7px, transparent 12px
      );
    "></div>
    <!-- Puntadas activas (tejidas con el scroll — más brillantes) -->
    <div id="stitch-filled" style="
      position:absolute;top:0;left:9px;width:2px;height:0%;
      background:repeating-linear-gradient(
        to bottom,
        #BFA255 0px, #BFA255 7px,
        transparent 7px, transparent 12px
      );
      filter:drop-shadow(0 0 2px rgba(191,162,85,0.5));
    "></div>
    <!-- Aguja — más grande, más detallada -->
    <div id="stitch-needle" style="position:absolute;top:0%;left:0;transform:translateY(-6px);">
      <svg width="22" height="36" viewBox="0 0 22 36" fill="none">
        <defs>
          <linearGradient id="ng-side" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stop-color="#906D22"/>
            <stop offset="40%" stop-color="#EDD080"/>
            <stop offset="70%" stop-color="#C8963C"/>
            <stop offset="100%" stop-color="#7A5818"/>
          </linearGradient>
        </defs>
        <!-- Sección del ojo (cápsula superior) -->
        <rect x="3" y="1" width="16" height="14" rx="8" fill="url(#ng-side)"/>
        <!-- Ojo de la aguja -->
        <ellipse cx="11" cy="7" rx="4.5" ry="5.5" fill="#0A0A12" opacity="0.88"/>
        <ellipse cx="11" cy="6" rx="1.5" ry="2" fill="#BFA255" opacity="0.25"/>
        <!-- Cuerpo que afina -->
        <path d="M3 14 Q2 22 4 29 L11 36 L18 29 Q20 22 19 14 Z" fill="url(#ng-side)"/>
        <!-- Brillo -->
        <line x1="9" y1="18" x2="8.5" y2="28" stroke="rgba(255,255,255,0.3)" stroke-width="1.5" stroke-linecap="round"/>
        <!-- Hilo dorado saliendo del ojo -->
        <path d="M6.5 7 Q3 5 0 8" stroke="#BFA255" stroke-width="1" stroke-linecap="round" fill="none" opacity="0.65"/>
      </svg>
    </div>
  </div>

  <Navbar />
  <main id="contenido">
    <Hero />

    <!-- ┄ costura ┄ -->
    <div aria-hidden="true" class="relative" style="height:1px;overflow:visible;z-index:5;">
      <div style="position:absolute;inset:0;background:repeating-linear-gradient(90deg,transparent 0,transparent 8px,rgba(191,162,85,0.22) 8px,rgba(191,162,85,0.22) 16px);"></div>
      <div class="absolute left-[22px] top-1/2 -translate-y-1/2" style="width:10px;height:18px;">
        <svg width="10" height="18" viewBox="0 0 10 18" fill="none"><ellipse cx="5" cy="3.5" rx="3.5" ry="2.5" stroke="#BFA255" stroke-width="1.1" fill="none"/><line x1="5" y1="6" x2="5" y2="15" stroke="#BFA255" stroke-width="1.1" stroke-linecap="round"/><path d="M3.5 13.5 L5 18 L6.5 13.5" fill="#BFA255"/></svg>
      </div>
    </div>

    <Stats />
    <TechBanner />

    <!-- ┄ costura ┄ -->
    <div aria-hidden="true" class="relative" style="height:1px;overflow:visible;z-index:5;">
      <div style="position:absolute;inset:0;background:repeating-linear-gradient(90deg,transparent 0,transparent 8px,rgba(191,162,85,0.22) 8px,rgba(191,162,85,0.22) 16px);"></div>
      <div class="absolute left-[22px] top-1/2 -translate-y-1/2" style="width:10px;height:18px;">
        <svg width="10" height="18" viewBox="0 0 10 18" fill="none"><ellipse cx="5" cy="3.5" rx="3.5" ry="2.5" stroke="#BFA255" stroke-width="1.1" fill="none"/><line x1="5" y1="6" x2="5" y2="15" stroke="#BFA255" stroke-width="1.1" stroke-linecap="round"/><path d="M3.5 13.5 L5 18 L6.5 13.5" fill="#BFA255"/></svg>
      </div>
    </div>

    <Services />
    <MockupShowcase />

    <!-- ┄ costura ┄ -->
    <div aria-hidden="true" class="relative" style="height:1px;overflow:visible;z-index:5;">
      <div style="position:absolute;inset:0;background:repeating-linear-gradient(90deg,transparent 0,transparent 8px,rgba(191,162,85,0.22) 8px,rgba(191,162,85,0.22) 16px);"></div>
      <div class="absolute left-[22px] top-1/2 -translate-y-1/2" style="width:10px;height:18px;">
        <svg width="10" height="18" viewBox="0 0 10 18" fill="none"><ellipse cx="5" cy="3.5" rx="3.5" ry="2.5" stroke="#BFA255" stroke-width="1.1" fill="none"/><line x1="5" y1="6" x2="5" y2="15" stroke="#BFA255" stroke-width="1.1" stroke-linecap="round"/><path d="M3.5 13.5 L5 18 L6.5 13.5" fill="#BFA255"/></svg>
      </div>
    </div>

    <WhyUs />
    <Products />
    <Verticals />

    <!-- ┄ costura ┄ -->
    <div aria-hidden="true" class="relative" style="height:1px;overflow:visible;z-index:5;">
      <div style="position:absolute;inset:0;background:repeating-linear-gradient(90deg,transparent 0,transparent 8px,rgba(191,162,85,0.22) 8px,rgba(191,162,85,0.22) 16px);"></div>
      <div class="absolute left-[22px] top-1/2 -translate-y-1/2" style="width:10px;height:18px;">
        <svg width="10" height="18" viewBox="0 0 10 18" fill="none"><ellipse cx="5" cy="3.5" rx="3.5" ry="2.5" stroke="#BFA255" stroke-width="1.1" fill="none"/><line x1="5" y1="6" x2="5" y2="15" stroke="#BFA255" stroke-width="1.1" stroke-linecap="round"/><path d="M3.5 13.5 L5 18 L6.5 13.5" fill="#BFA255"/></svg>
      </div>
    </div>

    <Founders />

    <!-- CTA Section — navy profundo con acento dorado -->
    <section id="diagnostico" class="py-28 px-6 relative overflow-hidden" style="background:linear-gradient(135deg,#0D1F3C 0%,#1B3461 55%,#1A2E55 100%);">
      <!-- Decoración sutil -->
      <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px]"
             style="background:radial-gradient(ellipse,rgba(191,162,85,0.08) 0%,transparent 65%);"></div>
        <div class="absolute inset-0 bg-grid" style="opacity:0.05;"></div>
        <!-- hilo dorado decorativo -->
        <svg class="absolute inset-0 w-full h-full opacity-10" viewBox="0 0 800 400" preserveAspectRatio="xMidYMid slice" fill="none">
          <path d="M0 200 Q200 80 400 200 Q600 320 800 200" stroke="#BFA255" stroke-width="1.5" stroke-dasharray="6 5"/>
        </svg>
      </div>

      <div class="max-w-3xl mx-auto text-center scroll-reveal relative z-10">
        <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full mb-6 text-xs font-bold tracking-wide"
              style="background:rgba(255,255,255,0.12);color:rgba(255,255,255,0.9);border:1px solid rgba(255,255,255,0.2);">
          <span class="w-1.5 h-1.5 rounded-full bg-white live-dot"></span>
          Diagnóstico inicial
        </span>
        <h2 class="text-3xl sm:text-5xl font-extrabold mb-5 leading-[1.1] text-white mt-2" style="font-family: 'Plus Jakarta Sans', sans-serif;">
          Una conversación para<br />
          encontrar el mejor inicio
        </h2>
        <p class="mb-10 max-w-xl mx-auto text-lg leading-relaxed" style="color:rgba(255,255,255,0.75);">
          Revisamos el proceso, los sistemas involucrados y el resultado que buscas para preparar un siguiente paso concreto.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="/diagnostico/"
            class="inline-flex items-center justify-center gap-2 px-8 py-4 rounded-xl font-bold transition-all hover:-translate-y-0.5 text-sm"
            style="background:white;color:#132848;box-shadow:0 8px 28px rgba(0,0,0,0.2);"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
            </svg>
            Solicitar diagnóstico
          </a>
          <a
            href="https://wa.me/573007244122?text=Hola%20Saastreria%2C%20quiero%20información%20sobre%20sus%20servicios"
            target="_blank"
            rel="noopener"
            class="inline-flex items-center justify-center gap-2 px-8 py-4 rounded-xl font-semibold transition-all hover:-translate-y-0.5 text-sm text-white"
            style="border:1.5px solid rgba(255,255,255,0.3);background:rgba(255,255,255,0.08);"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347"/>
            </svg>
            WhatsApp directo
          </a>
        </div>
      </div>
    </section>

    <!-- ┄ costura ┄ -->
    <div aria-hidden="true" class="relative" style="height:1px;overflow:visible;z-index:5;">
      <div style="position:absolute;inset:0;background:repeating-linear-gradient(90deg,transparent 0,transparent 8px,rgba(191,162,85,0.22) 8px,rgba(191,162,85,0.22) 16px);"></div>
      <div class="absolute left-[22px] top-1/2 -translate-y-1/2" style="width:10px;height:18px;">
        <svg width="10" height="18" viewBox="0 0 10 18" fill="none"><ellipse cx="5" cy="3.5" rx="3.5" ry="2.5" stroke="#BFA255" stroke-width="1.1" fill="none"/><line x1="5" y1="6" x2="5" y2="15" stroke="#BFA255" stroke-width="1.1" stroke-linecap="round"/><path d="M3.5 13.5 L5 18 L6.5 13.5" fill="#BFA255"/></svg>
      </div>
    </div>

    <FAQ />

    <StitchClosure />
  </main>
  <Footer />

  <!-- Bot flotante -->
  <DiagnosticBot client:only="react" />
</Base>

<script>
// ═══════════════════════════════════════════
// 1. SCROLL PROGRESS BAR
// ═══════════════════════════════════════════
const progressBar = document.getElementById('scroll-progress') as HTMLElement | null;
if (progressBar) {
  window.addEventListener('scroll', () => {
    const scrolled = window.scrollY;
    const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
    const ratio = maxScroll > 0 ? scrolled / maxScroll : 0;
    progressBar.style.transform = `scaleX(${ratio})`;
  }, { passive: true });
}

// ═══════════════════════════════════════════
// 2. SCROLL REVEAL (IntersectionObserver)
// ═══════════════════════════════════════════
const revealEls = document.querySelectorAll<HTMLElement>('.scroll-reveal');
const revealObs = new IntersectionObserver((entries) => {
  entries.forEach((entry) => {
    if (entry.isIntersecting) {
      (entry.target as HTMLElement).classList.add('visible');
      revealObs.unobserve(entry.target);
    }
  });
}, { threshold: 0.15 });
revealEls.forEach((el, i) => {
  if (!el.style.transitionDelay) el.style.transitionDelay = `${i * 0.05}s`;
  revealObs.observe(el);
});

// ═══════════════════════════════════════════
// 3. 3D TILT on service cards
// ═══════════════════════════════════════════
const cards = document.querySelectorAll<HTMLElement>('#servicios .glass');
cards.forEach((card) => {
  card.classList.add('tilt-card');
  const onMove = (e: MouseEvent) => {
    const rect = card.getBoundingClientRect();
    const cx = rect.left + rect.width / 2;
    const cy = rect.top + rect.height / 2;
    const dx = (e.clientX - cx) / (rect.width  / 2);
    const dy = (e.clientY - cy) / (rect.height / 2);
    card.style.transform = `perspective(600px) rotateY(${dx * 6}deg) rotateX(${-dy * 6}deg) translateY(-4px)`;
  };
  const onLeave = () => {
    card.style.transform = '';
  };
  card.addEventListener('mousemove', onMove);
  card.addEventListener('mouseleave', onLeave);
});

// ═══════════════════════════════════════════
// 4. CURSOR SPOTLIGHT (subtle mouse follow)
// ═══════════════════════════════════════════
const spotlight = document.createElement('div');
spotlight.style.cssText = `
  position: fixed; pointer-events: none; z-index: 1;
  width: 400px; height: 400px; border-radius: 50%;
  background: radial-gradient(circle, rgba(27,52,97,0.06) 0%, transparent 70%);
  transform: translate(-50%, -50%);
  transition: left 0.15s ease, top 0.15s ease;
  top: -999px; left: -999px;
`;
document.body.appendChild(spotlight);
window.addEventListener('mousemove', (e) => {
  spotlight.style.left = e.clientX + 'px';
  spotlight.style.top  = e.clientY + 'px';
}, { passive: true });

// ═══════════════════════════════════════════
// 5. STAGGER for service cards entrance
// ═══════════════════════════════════════════
const serviceCards = document.querySelectorAll<HTMLElement>('#servicios .glass');
const cardObs = new IntersectionObserver((entries) => {
  entries.forEach((entry, i) => {
    if (entry.isIntersecting) {
      const el = entry.target as HTMLElement;
      el.style.transitionDelay = `${Array.from(serviceCards).indexOf(el) * 0.1}s`;
      el.classList.add('visible');
      el.style.opacity = '1';
      el.style.transform = '';
      cardObs.unobserve(el);
    }
  });
}, { threshold: 0.1 });
serviceCards.forEach((card) => {
  card.style.opacity = '0';
  card.style.transform = 'translateY(24px)';
  card.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
  cardObs.observe(card);
});

// ═══════════════════════════════════════════
// 6. HILO QUE SE TEJE — scroll-driven stitch
// ═══════════════════════════════════════════
const stitchThread = document.getElementById('stitch-thread') as HTMLElement | null;
const stitchFilled = document.getElementById('stitch-filled') as HTMLElement | null;
const stitchNeedle = document.getElementById('stitch-needle') as HTMLElement | null;

if (stitchThread && stitchFilled && stitchNeedle) {
  // Mostrar en lg+ (≥1024px) — antes solo era xl+
  const mq = window.matchMedia('(min-width: 1024px)');
  const toggleVisibility = () => {
    stitchThread.style.display = mq.matches ? 'block' : 'none';
  };
  toggleVisibility();
  mq.addEventListener('change', toggleVisibility);

  // Lerp para suavizar el movimiento (tipo spring)
  let currentPct = 0;
  let targetPct  = 0;

  function updateTarget() {
    const scrolled  = window.scrollY;
    const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
    targetPct = maxScroll > 0 ? (scrolled / maxScroll) * 100 : 0;
  }

  function stitchLoop() {
    // Spring lerp — sensación de física suave
    currentPct += (targetPct - currentPct) * 0.09;
    const pct = Math.min(currentPct, 100);

    stitchFilled.style.height = pct + '%';
    stitchNeedle.style.top    = pct + '%';

    // Rotar aguja levemente al acelerar el scroll (pendiente del hilo)
    const speed = Math.abs(targetPct - currentPct);
    const tilt  = Math.min(speed * 1.2, 14);
    stitchNeedle.style.transform = `translateY(-4px) rotate(${tilt}deg)`;

    requestAnimationFrame(stitchLoop);
  }

  window.addEventListener('scroll', updateTarget, { passive: true });
  stitchLoop();
}

// ═══════════════════════════════════════════
// 7. SPRING REVEALS — animaciones tipo Framer Motion
// ═══════════════════════════════════════════
// Aplica spring cubic-bezier a todos los elementos scroll-reveal
const SPRING_EASING = 'cubic-bezier(0.175, 0.885, 0.32, 1.275)';
const SPRING_DURATION = '0.7s';
document.querySelectorAll<HTMLElement>('.scroll-reveal').forEach((el) => {
  el.style.transition = `opacity ${SPRING_DURATION} ${SPRING_EASING}, transform ${SPRING_DURATION} ${SPRING_EASING}`;
});
</script>
