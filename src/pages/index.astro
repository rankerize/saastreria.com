---
import Base from '../layouts/Base.astro';
import Navbar from '../components/sections/Navbar.astro';
import Hero from '../components/sections/Hero.astro';
import TechBanner from '../components/sections/TechBanner.astro';
import Services from '../components/sections/Services.astro';
import MockupShowcase from '../components/sections/MockupShowcase.astro';
import WhyUs from '../components/sections/WhyUs.astro';
import Products from '../components/sections/Products.astro';
import Verticals from '../components/sections/Verticals.astro';
import FAQ from '../components/sections/FAQ.astro';
import Footer from '../components/sections/Footer.astro';
import DiagnosticBot from '../components/ui/DiagnosticBot';
---

<Base>
  <!-- Scroll progress bar -->
  <div id="scroll-progress"></div>

  <Navbar />
  <main id="contenido">
    <Hero />
    <TechBanner />
    <Services />
    <MockupShowcase />
    <WhyUs />
    <Products />
    <Verticals />

    <!-- CTA Section -->
    <section id="diagnostico" class="py-24 px-6 bg-[#111118]">
      <div class="max-w-3xl mx-auto text-center scroll-reveal">
        <span class="inline-block px-3 py-1 rounded-full border border-[#6366F1]/30 bg-[#6366F1]/10 text-[#6366F1] text-xs font-medium mb-6">
          Diagnóstico inicial
        </span>
        <h2 class="text-3xl sm:text-4xl font-bold mb-4" style="font-family: 'Plus Jakarta Sans', sans-serif;">
          Una conversación para encontrar<br />
          <span class="gradient-text">el mejor punto de partida</span>
        </h2>
        <p class="text-[#94A3B8] mb-10 max-w-xl mx-auto">
          Revisamos el proceso, los sistemas involucrados y el resultado que buscas para preparar un siguiente paso concreto.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="/diagnostico/"
            class="inline-flex items-center justify-center gap-2 px-8 py-4 rounded-xl bg-[#6366F1] hover:bg-[#4F46E5] text-white font-semibold transition-all hover:shadow-[0_0_30px_rgba(99,102,241,0.4)] hover:-translate-y-0.5 text-sm"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
            </svg>
            Solicitar diagnóstico
          </a>
          <a
            href="https://wa.me/573007244122?text=Hola%20Saastreria%2C%20quiero%20información%20sobre%20sus%20servicios"
            target="_blank"
            rel="noopener"
            class="inline-flex items-center justify-center gap-2 px-8 py-4 rounded-xl border border-white/10 text-[#94A3B8] hover:text-white hover:border-white/20 font-medium transition-all text-sm"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347"/>
            </svg>
            WhatsApp directo
          </a>
        </div>
      </div>
    </section>

    <FAQ />
  </main>
  <Footer />

  <!-- Bot flotante -->
  <DiagnosticBot client:only="react" />
</Base>

<script>
// ═══════════════════════════════════════════
// 1. SCROLL PROGRESS BAR
// ═══════════════════════════════════════════
const progressBar = document.getElementById('scroll-progress') as HTMLElement | null;
if (progressBar) {
  window.addEventListener('scroll', () => {
    const scrolled = window.scrollY;
    const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
    const ratio = maxScroll > 0 ? scrolled / maxScroll : 0;
    progressBar.style.transform = `scaleX(${ratio})`;
  }, { passive: true });
}

// ═══════════════════════════════════════════
// 2. SCROLL REVEAL (IntersectionObserver)
// ═══════════════════════════════════════════
const revealEls = document.querySelectorAll<HTMLElement>('.scroll-reveal');
const revealObs = new IntersectionObserver((entries) => {
  entries.forEach((entry) => {
    if (entry.isIntersecting) {
      (entry.target as HTMLElement).classList.add('visible');
      revealObs.unobserve(entry.target);
    }
  });
}, { threshold: 0.15 });
revealEls.forEach((el, i) => {
  if (!el.style.transitionDelay) el.style.transitionDelay = `${i * 0.05}s`;
  revealObs.observe(el);
});

// ═══════════════════════════════════════════
// 3. 3D TILT on service cards
// ═══════════════════════════════════════════
const cards = document.querySelectorAll<HTMLElement>('#servicios .glass');
cards.forEach((card) => {
  card.classList.add('tilt-card');
  const onMove = (e: MouseEvent) => {
    const rect = card.getBoundingClientRect();
    const cx = rect.left + rect.width / 2;
    const cy = rect.top + rect.height / 2;
    const dx = (e.clientX - cx) / (rect.width  / 2);
    const dy = (e.clientY - cy) / (rect.height / 2);
    card.style.transform = `perspective(600px) rotateY(${dx * 6}deg) rotateX(${-dy * 6}deg) translateY(-4px)`;
  };
  const onLeave = () => {
    card.style.transform = '';
  };
  card.addEventListener('mousemove', onMove);
  card.addEventListener('mouseleave', onLeave);
});

// ═══════════════════════════════════════════
// 4. CURSOR SPOTLIGHT (subtle mouse follow)
// ═══════════════════════════════════════════
const spotlight = document.createElement('div');
spotlight.style.cssText = `
  position: fixed; pointer-events: none; z-index: 1;
  width: 400px; height: 400px; border-radius: 50%;
  background: radial-gradient(circle, rgba(99,102,241,0.06) 0%, transparent 70%);
  transform: translate(-50%, -50%);
  transition: left 0.15s ease, top 0.15s ease;
  top: -999px; left: -999px;
`;
document.body.appendChild(spotlight);
window.addEventListener('mousemove', (e) => {
  spotlight.style.left = e.clientX + 'px';
  spotlight.style.top  = e.clientY + 'px';
}, { passive: true });

// ═══════════════════════════════════════════
// 5. STAGGER for service cards entrance
// ═══════════════════════════════════════════
const serviceCards = document.querySelectorAll<HTMLElement>('#servicios .glass');
const cardObs = new IntersectionObserver((entries) => {
  entries.forEach((entry, i) => {
    if (entry.isIntersecting) {
      const el = entry.target as HTMLElement;
      el.style.transitionDelay = `${Array.from(serviceCards).indexOf(el) * 0.1}s`;
      el.classList.add('visible');
      el.style.opacity = '1';
      el.style.transform = '';
      cardObs.unobserve(el);
    }
  });
}, { threshold: 0.1 });
serviceCards.forEach((card) => {
  card.style.opacity = '0';
  card.style.transform = 'translateY(24px)';
  card.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
  cardObs.observe(card);
});
</script>
