---
import CommercialPage from '../../components/CommercialPage.astro';
import { productPages } from '../../data/commercial-pages';
export function getStaticPaths() { return productPages.map((page) => ({ params: { slug: page.slug }, props: { page } })); }
const { page } = Astro.props;
---
<CommercialPage page={page} canonicalPath={`/productos/${page.slug}/`} />
