---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  canonical?: string;
  pubDate?: string;
  author?: string;
  noindex?: boolean;
  schemas?: Record<string, unknown>[];
}

const SITE = 'https://saastreria.cloud';
const {
  title = 'Saastreria | Software, datos y automatización empresarial',
  description = 'Diseñamos software, automatizaciones y soluciones de datos a la medida para transformar procesos empresariales en Colombia y LATAM.',
  ogImage = '/og.png',
  ogType = 'website',
  canonical = Astro.url.pathname,
  pubDate,
  author = 'Equipo Saastreria',
  noindex = false,
  schemas = [],
} = Astro.props;

const canonicalURL = canonical.startsWith('http') ? canonical : new URL(canonical, SITE).href;
const ogImageURL = ogImage.startsWith('http') ? ogImage : new URL(ogImage, SITE).href;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': ['Organization', 'SoftwareCompany'],
  '@id': `${SITE}/#organization`,
  name: 'Saastreria',
  url: SITE,
  logo: `${SITE}/og.png`,
  email: 'hola@saastreria.cloud',
  description: 'Empresa de software, datos, automatización e inteligencia artificial aplicada a procesos empresariales.',
  areaServed: ['Colombia', 'LATAM'],
  knowsAbout: ['Software empresarial', 'Automatización de procesos', 'Ingeniería de datos', 'Inteligencia artificial empresarial', 'Modernización de software'],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE}/#website`,
  url: SITE,
  name: 'Saastreria',
  inLanguage: 'es-CO',
  publisher: { '@id': `${SITE}/#organization` },
};

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': ogType === 'article' ? 'BlogPosting' : 'WebPage',
  '@id': `${canonicalURL}#webpage`,
  url: canonicalURL,
  name: title,
  description,
  isPartOf: { '@id': `${SITE}/#website` },
  publisher: { '@id': `${SITE}/#organization` },
  inLanguage: 'es-CO',
  ...(pubDate ? { datePublished: pubDate, author: { '@type': 'Organization', name: author } } : {}),
};
---

<!DOCTYPE html>
<html lang="es-CO">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
    <meta name="author" content={author} />
    <meta name="theme-color" content="#0A0A0F" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Saastreria" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`Saastreria — ${title}`} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="es_CO" />
    {pubDate && <meta property="article:published_time" content={pubDate} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    {[orgSchema, websiteSchema, pageSchema, ...schemas].map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </head>
  <body class="bg-[#0A0A0F] text-[#F8FAFC] antialiased">
    <a href="#contenido" class="skip-link">Saltar al contenido</a>
    <slot />
  </body>
</html>
